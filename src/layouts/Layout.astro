---
import CrytoNav from '../components/CrytoNav.astro';

interface Props {
  title: string;
  showLogout?: boolean;
  showHome?: boolean;
  settingsMode?: boolean;
}
const { title, showLogout = false, showHome = false, settingsMode = false } = Astro.props;

// Off by default so a fork doesn't ship with the original owner's site
// branding. The canonical deployment sets PUBLIC_SHOW_CRYTO_NAV=true.
const showCrytoNav = import.meta.env.PUBLIC_SHOW_CRYTO_NAV === 'true';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #0f1115;
        --surface: #171a21;
        --border: #2a2e38;
        --text: #e8eaed;
        --text-dim: #9aa0aa;
        --accent: #5b9dff;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
        background: var(--bg);
        color: var(--text);
      }
      a { color: var(--accent); }
      .cryto-nav {
        position: sticky;
        top: 0;
        z-index: 40;
      }
      .app-nav {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: var(--cryto-nav-height, 0px);
        z-index: 30;
        background: var(--bg);
      }
      .settings-nav-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text);
        text-decoration: none;
        font-size: 0.9rem;
      }
      .settings-nav-btn svg { width: 1.1rem; height: 1.1rem; color: var(--text-dim); }
      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--text-dim);
        text-decoration: none;
        font-size: 0.85rem;
        margin-bottom: 1rem;
      }
      @media (hover: hover) { .back-link:hover { color: var(--text); } }
      main {
        padding: 1.5rem;
        max-width: 1400px;
        margin: 0 auto;
      }
      table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
        font-size: 0.9rem;
        text-size-adjust: 100%;
      }
      th, td {
        padding: 0.4rem 0.6rem;
        border-bottom: 1px solid var(--border);
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .title-cell {
        white-space: normal;
        overflow-wrap: break-word;
        text-overflow: clip;
      }
      th {
        user-select: none;
        color: var(--text-dim);
        position: sticky;
        top: 0;
        background: var(--bg);
        background-clip: padding-box;
      }
      .page-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .last-updated {
        color: var(--text-dim);
        font-size: 0.8rem;
        text-align: right;
        line-height: 1.4;
      }
      .search-row {
        display: flex;
        flex-direction: column;
        font-size: 0.75rem;
        color: var(--text-dim);
        gap: 0.25rem;
        max-width: 320px;
      }
      .table-toolbar {
        display: flex;
        align-items: flex-end;
        gap: 1rem;
        padding: 0 0 1rem;
        position: sticky;
        top: var(--header-sticky-height, 0px);
        z-index: 20;
        background: var(--bg);
      }
      .filters-toggle-btn {
        display: none;
        align-items: center;
        gap: 0.4rem;
        white-space: nowrap;
        height: fit-content;
      }
      .filters-toggle-btn svg { width: 1rem; height: 1rem; }
      .sidebar-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        z-index: 150;
      }
      .sidebar-backdrop.open { display: block; }
      .layout {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
      }
      .filters-sidebar {
        width: 200px;
        flex-shrink: 0;
      }
      @media (max-width: 768px) {
        .filters-toggle-btn { display: inline-flex; }
        .filters-sidebar {
          display: none;
          position: fixed;
          top: 0;
          left: 0;
          width: 85%;
          max-width: 300px;
          height: 100vh;
          overflow-y: auto;
          background: var(--bg);
          border-right: 1px solid var(--border);
          z-index: 200;
          padding: 1rem;
        }
        .filters-sidebar.open {
          display: flex;
          flex-direction: column;
        }
      }
      .filters-heading {
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        font-size: 0.75rem;
        color: var(--text-dim);
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.5rem;
        margin-bottom: 0.25rem;
      }
      .view-toggle {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
      }
      .view-btn {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
        padding: 0.6rem 0.3rem;
        font-size: 0.75rem;
        color: var(--text-dim);
        background: var(--surface);
        border: 1px solid var(--border);
      }
      .view-btn svg { width: 1.1rem; height: 1.1rem; }
      .view-btn.active {
        color: var(--text);
        border-color: var(--accent);
      }
      .filter-group {
        border-bottom: 1px solid var(--border);
      }
      .filter-group-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        background: none;
        border: none;
        color: var(--text);
        padding: 0.6rem 0;
        font-size: 0.85rem;
        text-align: left;
      }
      @media (hover: hover) { .filter-group-header:hover { color: var(--accent); } }
      .filter-group-header .arrow {
        color: var(--text-dim);
        transition: transform 0.15s;
      }
      .filter-group.open .filter-group-header .arrow {
        transform: rotate(90deg);
      }
      .filter-group-content {
        display: none;
        flex-direction: column;
        gap: 0.35rem;
        padding-bottom: 0.75rem;
        max-height: 220px;
        overflow-y: auto;
      }
      .filter-group.open .filter-group-content {
        display: flex;
      }
      .checkbox-row {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.85rem;
        color: var(--text);
        cursor: pointer;
      }
      .checkbox-row input[type="checkbox"] {
        width: auto;
        padding: 0;
        background: initial;
        border: initial;
        accent-color: var(--accent);
      }
      .table-container {
        flex: 1;
        min-width: 0;
      }
      .table-scroll {
        overflow-x: auto;
      }
      .col-chart { width: 90px; }
      .col-ex { width: 90px; }
      .col-grade { width: 70px; }
      .col-lamp { width: 140px; }
      .col-bp { width: 60px; }
      .show-mobile, .expand-row .show-mobile { display: none; }
      .stats-scroll { overflow-x: auto; }
      .pivot-table { table-layout: auto; }
      .sidebar-close-btn { display: none; }
      .song-row {
        cursor: pointer;
      }
      @media (hover: hover) { .song-row:hover { background: var(--surface); } }
      .song-row .expand-arrow {
        display: inline-block;
        color: var(--text-dim);
        margin-right: 0.4rem;
        transition: transform 0.15s;
      }
      .song-row.open .expand-arrow {
        transform: rotate(90deg);
      }
      .row-subtitle {
        color: var(--text-dim);
        font-size: 0.8em;
      }
      .chart-code {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
      }
      .expand-row td {
        background: var(--surface);
        white-space: normal;
        padding: 0.6rem;
      }
      .expand-row span {
        display: inline-block;
        margin-right: 1.5rem;
        color: var(--text-dim);
        font-size: 0.85rem;
      }
      .expand-row span strong {
        color: var(--text);
        font-weight: 500;
      }
      select, input, button {
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        padding: 0.4rem 0.5rem;
        border-radius: 4px;
        font-size: 0.9rem;
      }
      button {
        cursor: pointer;
        border-color: var(--accent);
      }
      @media (hover: hover) { button:hover { background: #1f2430; } }
      .scores-fab {
        position: fixed;
        left: 1.25rem;
        bottom: 1.25rem;
        width: 3rem;
        height: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text-dim);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        z-index: 100;
      }
      @media (hover: hover) {
        .scores-fab:hover {
          color: var(--text);
          border-color: var(--accent);
        }
      }
      .scores-fab svg { width: 1.4rem; height: 1.4rem; }
      .settings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1rem;
        max-width: 900px;
      }
      .settings-card {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 1rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        color: var(--text);
        text-decoration: none;
      }
      @media (hover: hover) { .settings-card:hover { border-color: var(--accent); } }
      .settings-card strong { font-size: 0.95rem; }
      .settings-card span { color: var(--text-dim); font-size: 0.85rem; }
      .game-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1.25rem;
        max-width: 900px;
        margin-top: 1.5rem;
      }
      .game-card {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 1rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        text-decoration: none;
      }
      @media (hover: hover) { .game-card:hover { border-color: var(--accent); } }
      .game-card-picture {
        aspect-ratio: 16 / 9;
        border-radius: 6px;
        background: linear-gradient(135deg, var(--border), var(--bg));
      }
      .game-card strong { font-size: 1rem; }
      .game-card span { color: var(--text-dim); font-size: 0.85rem; }
      .logout-fab {
        left: 4.75rem;
      }
      .home-fab {
        left: auto;
        right: 1.25rem;
      }
      code { overflow-wrap: anywhere; }

      @media (max-width: 768px) {
        main {
          padding: 1rem 1rem 5.5rem; /* bottom room so the FABs don't cover the last content */
        }
        h1 { font-size: 1.5rem; }
        .page-header { align-items: flex-start; flex-direction: column; gap: 0.25rem; }
        .last-updated { text-align: left; }
        /* Only the game nav stays frozen on small screens; the cryto.dev bar
           scrolls away so the fixed header doesn't eat a fifth of the screen. */
        .cryto-nav { position: static; }
        .app-nav {
          top: 0;
          gap: 1.25rem;
          padding: 0.75rem 1rem;
          overflow-x: auto;
          white-space: nowrap;
          font-size: 0.9rem;
          scrollbar-width: none;
        }
        /* iOS Safari zooms the page into any focused field under 16px. */
        select, input, textarea { font-size: 16px; }
        .hide-mobile { display: none; }
        .expand-row .show-mobile { display: inline-block; }
        table { font-size: 0.85rem; }
        .col-chart { width: 64px; }
        .col-grade { width: 56px; }
        .col-lamp { width: 100px; }
        th, td { padding: 0.4rem 0.35rem; }
        .filters-sidebar { height: 100dvh; overscroll-behavior: contain; }
        .sidebar-close-btn {
          display: block;
          align-self: flex-end;
          border: none;
          background: none;
          color: var(--text-dim);
          font-size: 1.1rem;
          padding: 0.25rem 0.5rem;
          margin-bottom: 0.25rem;
        }
        body.sidebar-open { overflow: hidden; }
        .filter-group-header { padding: 0.8rem 0; }
      }
    </style>
  </head>
  <body>
    {showCrytoNav && <CrytoNav />}
    {settingsMode ? (
      <nav class="app-nav">
        <a href="/settings" class="settings-nav-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
          beatmania IIDX Settings
        </a>
      </nav>
    ) : (
      <nav class="app-nav">
        <a href="/iidx">beatmania IIDX</a>
        <a href="/holodori">Hololive Dreams</a>
        <a href="/djmax">DJMAX Respect V</a>
      </nav>
    )}
    <main>
      <slot />
    </main>
    <a href="/login" class="scores-fab" aria-label="Manage scores" title="Manage scores">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
    </a>
    {showLogout && (
      <button id="logout-fab" class="scores-fab logout-fab" aria-label="Log out" title="Log out">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
      </button>
    )}
    {showHome && (
      <a href="/" class="scores-fab home-fab" aria-label="Home" title="Home">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9.5 12 3l9 6.5"></path>
          <path d="M5 10v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10"></path>
        </svg>
      </a>
    )}
    {showLogout && (
      <script>
        import { configuredClients } from '../lib/supabase';
        document.getElementById('logout-fab')!.addEventListener('click', async () => {
          await Promise.all(configuredClients().map(([, client]) => client.auth.signOut()));
          window.location.href = '/';
        });
      </script>
    )}
    <script>
      function updateHeaderHeights() {
        const crytoNav = document.querySelector('.cryto-nav') as HTMLElement | null;
        const appNav = document.querySelector('.app-nav') as HTMLElement | null;
        // Only sticky bars count -- on small screens the cryto.dev bar scrolls away.
        const stickyHeight = (el: HTMLElement | null) =>
          el && getComputedStyle(el).position === 'sticky' ? el.getBoundingClientRect().height : 0;
        const crytoNavHeight = stickyHeight(crytoNav);
        const appNavHeight = stickyHeight(appNav);
        document.documentElement.style.setProperty('--cryto-nav-height', `${crytoNavHeight}px`);
        document.documentElement.style.setProperty('--header-sticky-height', `${crytoNavHeight + appNavHeight}px`);
      }
      updateHeaderHeights();
      window.addEventListener('resize', updateHeaderHeights);
      // Which bars are sticky flips at the mobile breakpoint.
      window.matchMedia('(max-width: 768px)').addEventListener('change', updateHeaderHeights);
    </script>
  </body>
</html>
