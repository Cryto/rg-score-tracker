---
import CrytoNav from '../components/CrytoNav.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;

// Off by default so a fork doesn't ship with the original owner's site
// branding. The canonical deployment sets PUBLIC_SHOW_CRYTO_NAV=true.
const showCrytoNav = import.meta.env.PUBLIC_SHOW_CRYTO_NAV === 'true';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #0f1115;
        --surface: #171a21;
        --border: #2a2e38;
        --text: #e8eaed;
        --text-dim: #9aa0aa;
        --accent: #5b9dff;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
        background: var(--bg);
        color: var(--text);
      }
      a { color: var(--accent); }
      .app-nav {
        display: flex;
        gap: 1.5rem;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border);
      }
      main {
        padding: 1.5rem;
        max-width: 1400px;
        margin: 0 auto;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 0.9rem;
      }
      th, td {
        padding: 0.4rem 0.6rem;
        border-bottom: 1px solid var(--border);
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .title-cell {
        white-space: normal;
        overflow-wrap: break-word;
        text-overflow: clip;
      }
      th {
        user-select: none;
        color: var(--text-dim);
        position: sticky;
        top: 0;
        background: var(--bg);
      }
      .page-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .last-updated {
        color: var(--text-dim);
        font-size: 0.8rem;
        text-align: right;
        line-height: 1.4;
      }
      .search-row {
        display: flex;
        flex-direction: column;
        font-size: 0.75rem;
        color: var(--text-dim);
        gap: 0.25rem;
        max-width: 320px;
        margin: 1rem 0;
      }
      .layout {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
      }
      .filters-sidebar {
        width: 200px;
        flex-shrink: 0;
      }
      .filters-heading {
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        font-size: 0.75rem;
        color: var(--text-dim);
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.5rem;
        margin-bottom: 0.25rem;
      }
      .filter-group {
        border-bottom: 1px solid var(--border);
      }
      .filter-group-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        background: none;
        border: none;
        color: var(--text);
        padding: 0.6rem 0;
        font-size: 0.85rem;
        text-align: left;
      }
      .filter-group-header:hover { color: var(--accent); }
      .filter-group-header .arrow {
        color: var(--text-dim);
        transition: transform 0.15s;
      }
      .filter-group.open .filter-group-header .arrow {
        transform: rotate(90deg);
      }
      .filter-group-content {
        display: none;
        flex-direction: column;
        gap: 0.35rem;
        padding-bottom: 0.75rem;
        max-height: 220px;
        overflow-y: auto;
      }
      .filter-group.open .filter-group-content {
        display: flex;
      }
      .checkbox-row {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.85rem;
        color: var(--text);
        cursor: pointer;
      }
      .checkbox-row input[type="checkbox"] {
        width: auto;
        padding: 0;
        background: initial;
        border: initial;
        accent-color: var(--accent);
      }
      .table-container {
        flex: 1;
        min-width: 0;
        overflow-x: auto;
      }
      .song-row {
        cursor: pointer;
      }
      .song-row:hover { background: var(--surface); }
      .song-row .expand-arrow {
        display: inline-block;
        color: var(--text-dim);
        margin-right: 0.4rem;
        transition: transform 0.15s;
      }
      .song-row.open .expand-arrow {
        transform: rotate(90deg);
      }
      .row-subtitle {
        color: var(--text-dim);
        font-size: 0.8em;
      }
      .chart-code {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
      }
      .expand-row td {
        background: var(--surface);
        white-space: normal;
        padding: 0.6rem;
      }
      .expand-row span {
        display: inline-block;
        margin-right: 1.5rem;
        color: var(--text-dim);
        font-size: 0.85rem;
      }
      .expand-row span strong {
        color: var(--text);
        font-weight: 500;
      }
      select, input, button {
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        padding: 0.4rem 0.5rem;
        border-radius: 4px;
        font-size: 0.9rem;
      }
      button {
        cursor: pointer;
        border-color: var(--accent);
      }
      button:hover { background: #1f2430; }
      .scores-fab {
        position: fixed;
        left: 1.25rem;
        bottom: 1.25rem;
        width: 3rem;
        height: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text-dim);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        z-index: 100;
      }
      .scores-fab:hover {
        color: var(--text);
        border-color: var(--accent);
      }
      .scores-fab svg { width: 1.4rem; height: 1.4rem; }
    </style>
  </head>
  <body>
    {showCrytoNav && <CrytoNav />}
    <nav class="app-nav">
      <a href="/">beatmania IIDX</a>
      <a href="/hololive-dreams">Hololive Dreams</a>
      <a href="/djmax-respect-v">DJMAX Respect V</a>
    </nav>
    <main>
      <slot />
    </main>
    <a href="/login" class="scores-fab" aria-label="Manage scores" title="Manage scores">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
    </a>
  </body>
</html>
