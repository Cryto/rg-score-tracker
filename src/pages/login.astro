---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Login">
  <h1>Login</h1>
  <p style="color: var(--text-dim);">Only the site owner needs to log in — this is what lets you submit scores.</p>
  <form id="login-form" style="display:flex; flex-direction:column; gap:0.75rem; max-width:320px;">
    <label>Email <input type="email" id="email" required /></label>
    <label>Password <input type="password" id="password" required /></label>
    <button type="submit">Log in</button>
    <p id="status"></p>
  </form>

  <script>
    import { configuredClients } from '../lib/supabase';
    import { configuredGames } from '../games';

    const gameName = (id: string) => configuredGames.find((g) => g.id === id)?.name ?? id;
    const form = document.getElementById('login-form') as HTMLFormElement;
    const status = document.getElementById('status')!;

    // Already logged in to every configured game (e.g. via the settings
    // button) -- skip straight to /settings. If any game is missing a
    // session (say a newly added one), show the form so it can be signed in.
    Promise.all(configuredClients().map(([, client]) => client.auth.getSession())).then((results) => {
      if (results.length && results.every(({ data }) => data.session)) window.location.href = '/settings';
    });

    // Each game is a separate Supabase project with its own auth, so sign in
    // to all of them with the same credentials (the owner account must exist
    // in each project). Succeeding on at least one counts as logged in; the
    // rest just report their failures.
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      const results = await Promise.all(
        configuredClients().map(async ([game, client]) => {
          const { error } = await client.auth.signInWithPassword({ email, password });
          return { game, error };
        })
      );
      if (results.length === 0) {
        status.textContent = 'No games are set up yet. See .env.example.';
        return;
      }
      const failed = results.filter((r) => r.error);
      if (failed.length === results.length) {
        status.textContent = `Error: ${failed[0].error!.message}`;
        return;
      }
      status.textContent = failed.length
        ? `Logged in, but not to ${failed.map((r) => `${gameName(r.game)} (${r.error!.message})`).join(', ')}.`
        : 'Logged in.';
      setTimeout(() => (window.location.href = '/settings'), failed.length ? 2500 : 500);
    });
  </script>
</Layout>
