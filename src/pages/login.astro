---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Login">
  <h1>Login</h1>
  <p style="color: var(--text-dim);">Only the site owner needs to log in — this is what lets you submit scores.</p>
  <form id="login-form" style="display:flex; flex-direction:column; gap:0.75rem; max-width:320px;">
    <label>Email <input type="email" id="email" required /></label>
    <label>Password <input type="password" id="password" required /></label>
    <button type="submit">Log in</button>
    <p id="status"></p>
  </form>

  <script>
    import { configuredClients } from '../lib/supabase';

    const GAME_NAMES: Record<string, string> = { iidx: 'beatmania IIDX', holodori: 'Hololive Dreams' };
    const form = document.getElementById('login-form') as HTMLFormElement;
    const status = document.getElementById('status')!;

    // Already logged in to every configured game (e.g. via the settings
    // button) -- skip straight to /settings. If any game is missing a
    // session (say a newly added one), show the form so it can be signed in.
    Promise.all(configuredClients().map(([, client]) => client.auth.getSession())).then((results) => {
      if (results.every(({ data }) => data.session)) window.location.href = '/settings';
    });

    // Each game is a separate Supabase project with its own auth, so sign in
    // to all of them with the same credentials (the owner account must exist
    // in each project). IIDX is required; other games just report failures.
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      const results = await Promise.all(
        configuredClients().map(async ([game, client]) => {
          const { error } = await client.auth.signInWithPassword({ email, password });
          return { game, error };
        })
      );
      const iidxError = results.find((r) => r.game === 'iidx')?.error;
      const otherErrors = results.filter((r) => r.game !== 'iidx' && r.error);
      if (iidxError) {
        status.textContent = `Error: ${iidxError.message}`;
        return;
      }
      status.textContent = otherErrors.length
        ? `Logged in, but not to ${otherErrors.map((r) => `${GAME_NAMES[r.game] ?? r.game} (${r.error!.message})`).join(', ')}.`
        : 'Logged in.';
      setTimeout(() => (window.location.href = '/settings'), otherErrors.length ? 2500 : 500);
    });
  </script>
</Layout>
