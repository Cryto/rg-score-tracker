---
import Layout from '../layouts/Layout.astro';
import { configuredGames, listedGames } from '../games';

// Card pictures are linked from each game's official site or store page, never
// committed (same rule as the Holodori jackets). Each game's own folder sets
// them (src/games/<id>/game.ts).
const games = listedGames;
---
<Layout title="Rhythm Game Score Tracker">
  <h1>Rhythm Game Score Tracker</h1>
  <p style="color: var(--text-dim);">Pick a game to view its song list and your scores.</p>
  {configuredGames.length === 0 && (
    <p>No games are set up yet. Copy <code>.env.example</code> to <code>.env</code> and fill in at least one game's Supabase values.</p>
  )}
  <div class="game-grid">
    {games.map((game) => (
      <a class="game-card" href={game.route}>
        <div class="game-card-picture" aria-hidden="true">
          <img
            src={game.picture}
            alt=""
            decoding="async"
            referrerpolicy="no-referrer"
            data-fallback={game.pictureFallback}
            onerror="if (this.dataset.fallback && this.src !== this.dataset.fallback) { this.src = this.dataset.fallback; } else { this.remove(); }"
          />
        </div>
        <strong>{game.name}</strong>
        <span>{game.subtitle}</span>
      </a>
    ))}
  </div>
</Layout>
