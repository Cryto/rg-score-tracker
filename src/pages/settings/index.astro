---
import Layout from '../../layouts/Layout.astro';
import { configuredGames } from '../../games';
---
<Layout title="Settings" showLogout={true} showHome={true} settingsMode={true}>
  <h1>Settings</h1>

  {configuredGames.filter((game) => game.settingsLinks?.length).map((game) => (
    <>
      <h2 class="settings-game-heading">{game.name}</h2>
      <div class="settings-grid">
        {game.settingsLinks!.map((link) => (
          <a class="settings-card" href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.description}</span>
          </a>
        ))}
      </div>
    </>
  ))}

  <style>
    .settings-game-heading {
      font-size: 1rem;
      color: var(--text-dim);
      margin: 1.75rem 0 0.75rem;
    }
  </style>
</Layout>
