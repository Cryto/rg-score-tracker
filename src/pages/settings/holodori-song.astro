---
import Layout from '../../layouts/Layout.astro';
import { DIFFICULTIES, DIFFICULTY_LABELS, DIFFICULTY_COLORS } from '../../lib/holodori';
---
<Layout title="Add / Edit Hololive Dreams Song" showLogout={true} showHome={true} settingsMode={true}>
  <a href="/settings" class="back-link">← Back to Settings</a>
  <h1>Add / Edit Song — Hololive Dreams</h1>
  <p id="auth-warning" style="display:none; color: #ff8080;">
    You're not logged in to Hololive Dreams — <a href="/login">log in</a> to add or edit songs.
  </p>

  <form id="song-form" style="display:flex; flex-direction:column; gap:0.75rem; max-width:420px;">
    <label>Title (as shown in-game)
      <input id="title" type="text" required autocomplete="off" list="song-titles" />
      <datalist id="song-titles"></datalist>
    </label>
    <p id="match-note" class="hd-match-note"></p>
    <label>English title <span class="hd-optional">(optional)</span>
      <input id="title-en" type="text" autocomplete="off" />
    </label>
    <label>Credited singer / unit <span class="hd-optional">(optional)</span>
      <input id="artist" type="text" autocomplete="off" />
    </label>
    <div class="hd-members" id="members-field">
      <label for="member-input">Members <span class="hd-optional">(optional — individual members in this song)</span></label>
      <div id="member-chips" class="hd-chips"></div>
      <div class="hd-member-row">
        <input id="member-input" type="text" list="member-names" autocomplete="off" placeholder="Add a member..." />
        <button type="button" id="add-member">Add</button>
      </div>
      <datalist id="member-names"></datalist>
      <p id="members-note" class="hd-members-note"></p>
    </div>
    <fieldset class="hd-level-inputs">
      <legend>Difficulty levels</legend>
      {DIFFICULTIES.map((d) => (
        <label style={`--diff:${DIFFICULTY_COLORS[d]}`}>
          <span>{DIFFICULTY_LABELS[d]}</span>
          <input type="number" min="1" max="99" inputmode="numeric" data-difficulty={d} />
        </label>
      ))}
    </fieldset>
    <button type="submit" id="submit-btn">Add Song</button>
    <p id="status" style="color: var(--text-dim);"></p>
    <p style="color: var(--text-dim); font-size: 0.85rem;">
      Blank fields are left as they are when editing an existing song. Edits made here survive
      re-running the catalog import script, which only fills in missing titles, singers and levels
      (unless run with <code>--force</code>).
    </p>
  </form>

  <style>
    .hd-optional { color: var(--text-dim); font-size: 0.85em; }
    .hd-match-note { margin: -0.4rem 0 0; font-size: 0.85rem; color: var(--text-dim); min-height: 1.2em; }
    .hd-level-inputs {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.4rem;
      border: none;
      padding: 0;
      margin: 0;
    }
    .hd-level-inputs legend { padding: 0; margin-bottom: 0.35rem; }
    .hd-level-inputs label { display: flex; flex-direction: column; gap: 0.25rem; }
    .hd-level-inputs span { color: var(--diff); font-weight: 700; font-size: 0.85rem; }
    .hd-level-inputs input { width: 100%; border-color: var(--diff); text-align: center; font-weight: 700; }
    .hd-members { display: flex; flex-direction: column; gap: 0.35rem; }
    .hd-member-row { display: flex; gap: 0.4rem; }
    .hd-member-row input { flex: 1; min-width: 0; }
    .hd-members-note { margin: 0; font-size: 0.8rem; color: var(--text-dim); }
  </style>

  <!-- Global: chips are created from JS, which Astro's scoped styles can't reach. -->
  <style is:global>
    .hd-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .hd-chips:empty { display: none; }
    .hd-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.15rem 0.25rem 0.15rem 0.6rem;
      border-radius: 999px;
      background: var(--surface);
      border: 1px solid var(--border);
      font-size: 0.85rem;
    }
    .hd-chip button {
      border: none;
      background: none;
      padding: 0 0.3rem;
      color: var(--text-dim);
      font-size: 0.8rem;
      line-height: 1;
    }
  </style>

  <script>
    import { getSupabase } from '../../lib/supabase';
    import { DIFFICULTIES, GROUP_NAMES } from '../../lib/holodori';

    const supabase = getSupabase('holodori');
    const authWarning = document.getElementById('auth-warning')!;
    const form = document.getElementById('song-form') as HTMLFormElement;
    const titleEl = document.getElementById('title') as HTMLInputElement;
    const titleEnEl = document.getElementById('title-en') as HTMLInputElement;
    const artistEl = document.getElementById('artist') as HTMLInputElement;
    const datalist = document.getElementById('song-titles')!;
    const matchNote = document.getElementById('match-note')!;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const status = document.getElementById('status')!;
    const levelInputs = [...document.querySelectorAll<HTMLInputElement>('[data-difficulty]')];

    type ExistingSong = { id: number; titleJp: string; titleEn: string | null; artist: string | null; members: string[]; levels: Record<string, number | null> };
    let existing = new Map<string, ExistingSong>();
    let match: ExistingSong | null = null;

    // Members: individual people related to the song, stored separately from
    // the credited singer/unit (songs.members, migration 0002).
    const membersField = document.getElementById('members-field')!;
    const memberInput = document.getElementById('member-input') as HTMLInputElement;
    const memberChips = document.getElementById('member-chips')!;
    const memberNames = document.getElementById('member-names')!;
    const membersNote = document.getElementById('members-note')!;
    let members: string[] = [];
    let membersSupported = true;
    const splitCredit = (s: string | null) => (s ? s.split(/\s*(?:,|、|&)\s*/).map((x) => x.trim()).filter(Boolean) : []);

    function renderChips() {
      memberChips.innerHTML = '';
      for (const name of members) {
        const chip = document.createElement('span');
        chip.className = 'hd-chip';
        chip.textContent = name;
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.textContent = '✕';
        remove.setAttribute('aria-label', `Remove ${name}`);
        remove.addEventListener('click', () => {
          members = members.filter((m) => m !== name);
          renderChips();
        });
        chip.append(remove);
        memberChips.append(chip);
      }
    }

    function addMember() {
      const name = memberInput.value.trim();
      if (name && !members.some((m) => m.toLowerCase() === name.toLowerCase())) {
        members.push(name);
        renderChips();
      }
      memberInput.value = '';
      memberInput.focus();
    }
    document.getElementById('add-member')!.addEventListener('click', addMember);
    // Enter adds the member instead of submitting the form.
    memberInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        addMember();
      }
    });

    // Same looseness as the level-sheet importer: ignore width, case, spacing, punctuation.
    const norm = (s: string) => s.normalize('NFKC').toLowerCase().replace(/[\s・·.,!?~〜☆★♡♪'’"“”()[\]「」『』:\-‐―–—_/]/g, '');

    async function load() {
      if (!supabase) {
        status.textContent = 'Hololive Dreams isn\'t configured on this deployment.';
        submitBtn.disabled = true;
        return;
      }
      supabase.auth.getSession().then(({ data }) => {
        if (!data.session) authWarning.style.display = '';
      });
      let { data, error } = await supabase
        .from('songs')
        .select('id, title_jp, title_en, artist_jp, artist_en, members, charts ( difficulty, level )');
      // Database without migration 0002: work without members.
      if (error && /members/.test(error.message)) {
        membersSupported = false;
        membersField.style.display = 'none';
        ({ data, error } = await supabase
          .from('songs')
          .select('id, title_jp, title_en, artist_jp, artist_en, charts ( difficulty, level )'));
      }
      if (error) {
        status.textContent = `Failed to load songs: ${error.message}`;
        return;
      }
      // Keyed by both the JP and EN title, so typing either finds the song
      // instead of creating a duplicate.
      existing = new Map();
      const songsList: ExistingSong[] = (data ?? []).map((s: any) => ({
        id: s.id, titleJp: s.title_jp, titleEn: s.title_en, artist: s.artist_en ?? s.artist_jp,
        members: s.members ?? [],
        levels: Object.fromEntries((s.charts ?? []).map((c: any) => [c.difficulty, c.level])),
      }));
      for (const s of songsList) {
        existing.set(norm(s.titleJp), s);
        if (s.titleEn) existing.set(norm(s.titleEn), s);
      }
      datalist.innerHTML = '';
      for (const s of songsList) datalist.append(new Option(s.titleEn && s.titleEn !== s.titleJp ? s.titleEn : '', s.titleJp));
      // Suggest every known individual: names in credits (minus groups) plus added members.
      const known = new Set<string>();
      for (const s of songsList) {
        for (const n of splitCredit(s.artist)) if (!GROUP_NAMES.has(n)) known.add(n);
        for (const n of s.members) known.add(n);
      }
      memberNames.innerHTML = '';
      for (const n of [...known].sort((a, b) => a.localeCompare(b))) memberNames.append(new Option(n));
    }

    // Typing (or picking) an existing title switches to edit mode and shows its current values.
    titleEl.addEventListener('input', () => {
      const found = existing.get(norm(titleEl.value)) ?? null;
      if (found === match) return;
      match = found;
      if (match) {
        matchNote.textContent = `Already in the catalog as "${match.titleJp}" — saving updates it.`;
        titleEnEl.placeholder = match.titleEn ?? '';
        artistEl.placeholder = match.artist ?? '';
        for (const input of levelInputs) input.value = match.levels[input.dataset.difficulty!]?.toString() ?? '';
        members = [...match.members];
        const credited = splitCredit(match.artist).filter((n) => !GROUP_NAMES.has(n));
        membersNote.textContent = credited.length
          ? `Already counted from the credit: ${credited.join(', ')} — no need to add them.`
          : '';
        submitBtn.textContent = 'Update Song';
      } else {
        matchNote.textContent = titleEl.value.trim() ? 'New song.' : '';
        titleEnEl.placeholder = artistEl.placeholder = '';
        for (const input of levelInputs) input.value = '';
        members = [];
        membersNote.textContent = '';
        submitBtn.textContent = 'Add Song';
      }
      renderChips();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!supabase) return;
      const titleJp = titleEl.value.trim();
      if (!titleJp) return;
      const levels = levelInputs.map((input) => ({ difficulty: input.dataset.difficulty!, level: input.value ? Number(input.value) : null }));
      if (levels.some((l) => l.level != null && (!Number.isInteger(l.level) || l.level < 1 || l.level > 99))) {
        status.textContent = 'Levels must be whole numbers from 1 to 99.';
        return;
      }
      const filled = levels.map((l) => l.level).filter((n): n is number => n != null);
      const warning = filled.some((n, i) => i && n < filled[i - 1]) ? ' (Heads up: levels don\'t go up from Easy to Expert.)' : '';
      submitBtn.disabled = true;
      status.textContent = 'Saving...';

      // Existing song: only send fields that were filled in, so blanks keep current values.
      const songFields: Record<string, unknown> = {};
      if (titleEnEl.value.trim()) songFields.title_en = titleEnEl.value.trim();
      if (artistEl.value.trim()) songFields.artist_en = artistEl.value.trim();
      // A name typed but not yet added with Enter/Add still counts.
      if (memberInput.value.trim()) addMember();
      // Members are shown pre-filled, so save them whenever they differ from
      // what's stored (including removing all of them).
      const storedMembers = match?.members ?? [];
      if (membersSupported && (members.length !== storedMembers.length || members.some((m, i) => m !== storedMembers[i]))) {
        songFields.members = members.length ? members : null;
      }

      let songId: number;
      if (match) {
        songId = match.id;
        if (Object.keys(songFields).length) {
          const { error } = await supabase.from('songs').update(songFields).eq('id', songId);
          if (error) { status.textContent = `Error: ${error.message}`; submitBtn.disabled = false; return; }
        }
      } else {
        const { data, error } = await supabase.from('songs').insert({ title_jp: titleJp, ...songFields }).select('id').single();
        if (error) { status.textContent = `Error: ${error.message}`; submitBtn.disabled = false; return; }
        songId = data.id;
      }

      // New songs get all four charts (so scores can be entered even before a level is known);
      // existing songs only get the levels that were filled in.
      const chartRows = levels
        .filter((l) => !match || l.level != null)
        .map((l) => ({ song_id: songId, difficulty: l.difficulty, level: l.level }));
      if (chartRows.length) {
        const { error } = await supabase.from('charts').upsert(chartRows, { onConflict: 'song_id,difficulty' });
        if (error) { status.textContent = `Song saved, but levels failed: ${error.message}`; submitBtn.disabled = false; return; }
      }
      await supabase.from('catalog_syncs').insert({});

      status.textContent = `${match ? 'Updated' : 'Added'} "${match?.titleJp ?? titleJp}".${warning}`;
      submitBtn.disabled = false;
      await load();
      titleEl.dispatchEvent(new Event('input'));
    });

    load();
  </script>
</Layout>
