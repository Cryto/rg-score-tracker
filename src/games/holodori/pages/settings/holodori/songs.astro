---
import Layout from '@/layouts/Layout.astro';
---
<Layout title="Edit Hololive Dreams Song Database" showLogout={true} showHome={true} settingsMode={true}>
  <a href="/settings" class="back-link">← Back to Settings</a>
  <h1>Edit Song Database — Hololive Dreams</h1>
  <p id="auth-warning" style="display:none; color: #ff8080;">
    You're not logged in to Hololive Dreams — <a href="/login">log in</a> to edit or remove songs.
  </p>

  <div class="hd-db-controls">
    <input id="search" type="search" placeholder="Title, singer or member (EN / JP)..." autocomplete="off" aria-label="Search songs" />
    <fieldset class="choice-picker" id="views">
      <legend>Show</legend>
      <label><input type="checkbox" name="view" value="all" checked /><span>All <b data-count="all"></b></span></label>
      <label><input type="checkbox" name="view" value="untyped" /><span>No song type <b data-count="untyped"></b></span></label>
      <label><input type="checkbox" name="view" value="nomember" /><span>No member <b data-count="nomember"></b></span></label>
      <label><input type="checkbox" name="view" value="nojacket" /><span>No jacket <b data-count="nojacket"></b></span></label>
    </fieldset>
    <p id="view-note" class="hd-db-note"></p>
  </div>
  <p id="status" style="color: var(--text-dim);"></p>
  <ul id="song-list" class="hd-db-list"></ul>
  <datalist id="member-names"></datalist>
  <p id="empty" style="color: var(--text-dim);" hidden></p>

  <style>
    .hd-db-controls { display: flex; flex-direction: column; gap: 0.6rem; max-width: 680px; margin-bottom: 0.75rem; }
    .hd-db-controls input[type="search"] { width: 100%; box-sizing: border-box; }
    .hd-db-controls b { font-weight: 400; opacity: 0.75; }
    .hd-db-note { margin: 0; font-size: 0.85rem; color: var(--text-dim); min-height: 1.2em; }
  </style>

  <!-- Global: rows are created from JS, which Astro's scoped styles can't reach. -->
  <style is:global>
    .hd-db-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; max-width: 900px; }
    .hd-db-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.35rem 0.75rem;
      padding: 0.55rem 0.75rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
    }
    .hd-db-song { flex: 1 1 16rem; min-width: 0; display: flex; flex-direction: column; gap: 0.15rem; overflow-wrap: anywhere; }
    .hd-db-song small { color: var(--text-dim); font-size: 0.8rem; }
    .hd-db-missing { color: #ffb86b; }
    .hd-db-actions { display: flex; gap: 0.4rem; margin-left: auto; }
    .hd-db-actions a {
      padding: 0.4rem 0.6rem;
      border: 1px solid var(--accent);
      border-radius: 4px;
      color: var(--text);
      text-decoration: none;
      font-size: 0.9rem;
    }
    .hd-db-remove { border-color: #8a3a3a; color: #ff9a9a; }
    /* Inline fixes in the cleanup views, between the song and its actions. */
    .hd-db-fix { display: flex; flex-direction: column; gap: 0.3rem; flex: 0 1 16rem; min-width: 12rem; margin-left: auto; }
    .hd-db-fix + .hd-db-actions { margin-left: 0; }
    .hd-db-fix-row { display: flex; gap: 0.4rem; }
    .hd-db-fix-row input { flex: 1; min-width: 0; }
    .hd-db-saved { margin: 0; font-size: 0.8rem; color: var(--text-dim); min-height: 1em; }
    .hd-db-saved.error { color: #ff8080; }
    .hd-jacket-row { display: flex; gap: 0.4rem; align-items: center; }
    .hd-jacket-row input { flex: 1; min-width: 0; }
    .hd-jacket-preview {
      flex: none;
      width: 36px;
      height: 36px;
      border-radius: 4px;
      overflow: hidden;
      background: linear-gradient(135deg, var(--border), var(--surface));
    }
    .hd-jacket-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .hd-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .hd-chips:empty { display: none; }
    .hd-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.15rem 0.25rem 0.15rem 0.6rem;
      border-radius: 999px;
      border: 1px solid var(--border);
      font-size: 0.85rem;
    }
    .hd-chip button { border: none; background: none; padding: 0 0.3rem; color: var(--text-dim); font-size: 0.8rem; line-height: 1; }
    @media (hover: hover) {
      .hd-db-actions a:hover { background: #1f2430; }
      .hd-db-remove:hover { background: #3a1f1f; }
    }
  </style>

  <script>
    import { getSupabase } from '@/lib/supabase';
    import { GROUP_NAMES, jacketFromLink } from '../../../holodori';
    import { searchKey } from '@/lib/search';
    import { singleChoice } from '@/lib/choice';
    import { initComboboxes } from '@/lib/combobox';

    type Song = {
      id: number; titleJp: string; titleEn: string | null; credit: string | null;
      category: string | null; members: string[]; individuals: string[]; jacketUrl: string | null;
      scores: number; attempts: number; search: string;
    };
    type View = 'all' | 'untyped' | 'nomember' | 'nojacket';

    const supabase = getSupabase('holodori');
    const authWarning = document.getElementById('auth-warning')!;
    const searchEl = document.getElementById('search') as HTMLInputElement;
    const viewInputs = [...document.querySelectorAll<HTMLInputElement>('input[name="view"]')];
    const viewEl = singleChoice(viewInputs);
    const viewNote = document.getElementById('view-note')!;
    const status = document.getElementById('status')!;
    const listEl = document.getElementById('song-list')!;
    const emptyEl = document.getElementById('empty')!;

    const VIEW_NOTES: Record<View, string> = {
      all: '',
      untyped: 'Songs with neither Original nor Cover set. Pick one on the right to save it.',
      nomember: 'Songs with no members added and no individual singer in the credit (only a group, or no credit). Some songs have none; add members on the right to the ones that should. Each change saves right away.',
      nojacket: 'Songs with no jacket image. Paste a YouTube video link (its thumbnail is used) or an https image link on the right, check the preview, then Save. Afterwards, re-export catalog.json so forks get them.',
    };
    const splitCredit = (s: string | null) => (s ? s.split(/\s*(?:,|、|&)\s*/).map((x) => x.trim()).filter(Boolean) : []);
    const VIEWS: Record<View, (s: Song) => boolean> = {
      all: () => true,
      untyped: (s) => !s.category,
      nomember: (s) => !s.members.length && !s.individuals.length,
      nojacket: (s) => !s.jacketUrl,
    };

    let songs: Song[] = [];
    let membersSupported = true;

    function currentView(): View {
      return (viewEl.value || 'all') as View;
    }

    async function load() {
      if (!supabase) {
        status.textContent = 'Hololive Dreams isn\'t configured on this deployment.';
        return;
      }
      supabase.auth.getSession().then(({ data }) => {
        if (!data.session) authWarning.style.display = '';
      });
      status.textContent = 'Loading...';
      const cols = 'id, title_jp, title_en, artist_jp, artist_en, category, jacket_url, charts ( scores ( chart_id ), score_attempts ( id ) )';
      let { data, error }: { data: any[] | null; error: { message: string } | null } =
        await supabase.from('songs').select(`${cols}, members`).order('title_jp');
      // Database without migration 0002: work without members.
      if (error && /members/.test(error.message)) {
        membersSupported = false;
        ({ data, error } = await supabase.from('songs').select(cols).order('title_jp'));
      }
      if (error) {
        status.textContent = `Failed to load songs: ${error.message}`;
        return;
      }
      songs = (data ?? []).map((s: any) => {
        const credit = s.artist_en ?? s.artist_jp;
        const members: string[] = s.members ?? [];
        return {
          id: s.id, titleJp: s.title_jp, titleEn: s.title_en, credit, category: s.category, members, jacketUrl: s.jacket_url,
          individuals: splitCredit(credit).filter((n) => !GROUP_NAMES.has(n)),
          scores: (s.charts ?? []).reduce((n: number, c: any) => n + (c.scores?.length ?? 0), 0),
          attempts: (s.charts ?? []).reduce((n: number, c: any) => n + (c.score_attempts?.length ?? 0), 0),
          search: searchKey([s.title_jp, s.title_en, s.artist_jp, s.artist_en, ...members].filter(Boolean).join(' ')),
        };
      });
      // Member suggestions: every known individual, from credits (minus groups) and added members.
      const known = new Set<string>();
      for (const song of songs) for (const n of [...song.individuals, ...song.members]) known.add(n);
      document.getElementById('member-names')!
        .replaceChildren(...[...known].sort((a, b) => a.localeCompare(b)).map((n) => new Option(n)));
      status.textContent = '';
      render();
    }

    /** Saves fields on one song, reporting in note. Returns whether it saved. */
    async function saveSong(song: Song, fields: Record<string, unknown>, note: HTMLElement) {
      if (!supabase) return false;
      note.classList.remove('error');
      note.textContent = 'Saving...';
      // RLS turns an update the account may not make into a silent no-op, so
      // ask for the row back and treat none as a failure.
      const { data, error } = await supabase.from('songs').update(fields).eq('id', song.id).select('id');
      if (error || !data?.length) {
        note.textContent = `Not saved: ${error?.message ?? 'log in first'}`;
        note.classList.add('error');
        return false;
      }
      await supabase.from('catalog_syncs').insert({});
      note.textContent = 'Saved.';
      return true;
    }

    /** Song type buttons for the No song type view; saves on click. */
    function typeFix(song: Song) {
      const wrap = document.createElement('div');
      wrap.className = 'hd-db-fix';
      const picker = document.createElement('fieldset');
      picker.className = 'choice-picker';
      picker.setAttribute('aria-label', `Song type for ${song.titleJp}`);
      const inputs = (['original', 'cover'] as const).map((value) => {
        const label = document.createElement('label');
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.name = `type-${song.id}`;
        input.value = value;
        input.checked = song.category === value;
        const text = document.createElement('span');
        text.textContent = value === 'original' ? 'Original' : 'Cover';
        label.append(input, text);
        picker.append(label);
        return input;
      });
      const choice = singleChoice(inputs);
      const note = document.createElement('p');
      note.className = 'hd-db-saved';
      for (const input of inputs) {
        input.addEventListener('change', async () => {
          const previous = song.category ?? '';
          // Song type is required: clicking the chosen one again keeps it.
          if (!choice.value || choice.value === previous) {
            choice.value = previous;
            return;
          }
          const category = choice.value;
          for (const i of inputs) i.disabled = true;
          if (await saveSong(song, { category }, note)) {
            song.category = category;
            updateCounts();
          } else {
            choice.value = previous;
          }
          for (const i of inputs) i.disabled = false;
        });
      }
      wrap.append(picker, note);
      return wrap;
    }

    /** Member chips and an Add field for the No member view; saves on each change. */
    function memberFix(song: Song) {
      const wrap = document.createElement('div');
      wrap.className = 'hd-db-fix';
      const chips = document.createElement('div');
      chips.className = 'hd-chips';
      const fieldRow = document.createElement('div');
      fieldRow.className = 'hd-db-fix-row';
      const input = document.createElement('input');
      input.type = 'text';
      input.setAttribute('list', 'member-names');
      input.autocomplete = 'off';
      input.placeholder = 'Add a member...';
      input.setAttribute('aria-label', `Add a member to ${song.titleJp}`);
      const add = document.createElement('button');
      add.type = 'button';
      add.textContent = 'Add';
      fieldRow.append(input, add);
      const note = document.createElement('p');
      note.className = 'hd-db-saved';

      async function setMembers(next: string[]) {
        add.disabled = true;
        if (await saveSong(song, { members: next.length ? next : null }, note)) {
          song.members = next;
          song.search = searchKey([song.titleJp, song.titleEn, song.credit, ...next].filter(Boolean).join(' '));
          renderChips();
          updateCounts();
        }
        add.disabled = false;
      }
      function renderChips() {
        chips.replaceChildren(...song.members.map((name) => {
          const chip = document.createElement('span');
          chip.className = 'hd-chip';
          chip.textContent = name;
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.textContent = '✕';
          remove.setAttribute('aria-label', `Remove ${name}`);
          remove.addEventListener('click', () => setMembers(song.members.filter((m) => m !== name)));
          chip.append(remove);
          return chip;
        }));
      }
      function addMember() {
        const name = input.value.trim();
        input.value = '';
        if (!name || song.members.some((m) => m.toLowerCase() === name.toLowerCase())) return;
        setMembers([...song.members, name]);
      }
      add.addEventListener('click', addMember);
      // Enter adds the member (the suggestion list picks on Enter first).
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          addMember();
        }
      });
      renderChips();
      wrap.append(chips, fieldRow, note);
      return wrap;
    }

    /** Jacket link field with a preview for the No jacket view; saves on Save. */
    function jacketFix(song: Song) {
      const wrap = document.createElement('div');
      wrap.className = 'hd-db-fix';
      const fieldRow = document.createElement('div');
      fieldRow.className = 'hd-jacket-row';
      const preview = document.createElement('div');
      preview.className = 'hd-jacket-preview';
      preview.setAttribute('aria-hidden', 'true');
      const img = document.createElement('img');
      img.alt = '';
      img.hidden = true;
      preview.append(img);
      const input = document.createElement('input');
      input.type = 'url';
      input.inputMode = 'url';
      input.autocomplete = 'off';
      input.placeholder = 'YouTube or image link...';
      input.setAttribute('aria-label', `Jacket link for ${song.titleJp}`);
      const save = document.createElement('button');
      save.type = 'button';
      save.textContent = 'Save';
      save.disabled = true;
      fieldRow.append(preview, input, save);
      const note = document.createElement('p');
      note.className = 'hd-db-saved';

      // The image must load before Save is offered, same check as the song form.
      let src: string | null = null;
      input.addEventListener('input', () => {
        note.classList.remove('error');
        save.disabled = true;
        const link = input.value.trim();
        src = link ? jacketFromLink(link) : null;
        img.hidden = !src;
        if (!link) {
          img.removeAttribute('src');
          note.textContent = '';
          return;
        }
        if (!src) {
          img.removeAttribute('src');
          note.textContent = 'That isn\'t an https:// link.';
          note.classList.add('error');
          return;
        }
        const checking = src;
        note.textContent = 'Loading preview...';
        img.onload = () => {
          if (src !== checking) return;
          note.textContent = src === link ? 'Image found.' : 'Video thumbnail found.';
          save.disabled = false;
        };
        img.onerror = () => {
          if (src !== checking) return;
          img.hidden = true;
          note.textContent = 'Couldn\'t load an image from that link.';
          note.classList.add('error');
        };
        img.src = src;
      });
      async function saveJacket() {
        if (!src || save.disabled) return;
        save.disabled = true;
        if (await saveSong(song, { jacket_url: src }, note)) {
          song.jacketUrl = src;
          updateCounts();
        } else {
          save.disabled = false;
        }
      }
      save.addEventListener('click', saveJacket);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          saveJacket();
        }
      });
      wrap.append(fieldRow, note);
      return wrap;
    }

    function row(song: Song) {
      const li = document.createElement('li');
      li.className = 'hd-db-row';
      const info = document.createElement('div');
      info.className = 'hd-db-song';
      const title = document.createElement('strong');
      title.textContent = song.titleJp;
      info.append(title);
      if (song.titleEn && song.titleEn !== song.titleJp) {
        const en = document.createElement('small');
        en.textContent = song.titleEn;
        info.append(en);
      }
      const details = document.createElement('small');
      const type = document.createElement('span');
      type.textContent = song.category === 'original' ? 'Original' : song.category === 'cover' ? 'Cover' : 'No song type';
      if (!song.category) type.className = 'hd-db-missing';
      const people = document.createElement('span');
      const who = [song.credit, song.members.length ? `members: ${song.members.join(', ')}` : ''].filter(Boolean).join(' · ');
      people.textContent = who || 'No singer or members';
      if (membersSupported && VIEWS.nomember(song)) people.className = 'hd-db-missing';
      const scores = song.scores ? ` · ${song.scores} score${song.scores === 1 ? '' : 's'}` : '';
      details.append(type, ' · ', people, scores);
      info.append(details);

      const actions = document.createElement('div');
      actions.className = 'hd-db-actions';
      const edit = document.createElement('a');
      edit.href = `/settings/holodori/song?song=${encodeURIComponent(song.titleJp)}`;
      edit.textContent = 'Edit';
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'hd-db-remove';
      remove.textContent = 'Remove';
      remove.addEventListener('click', () => removeSong(song, remove));
      actions.append(edit, remove);
      // Fixed songs stay listed (not re-filtered) until the view or search
      // changes, so a misclick can be put right in place.
      const view = currentView();
      const fix = view === 'untyped' ? typeFix(song)
        : view === 'nomember' && membersSupported ? memberFix(song)
        : view === 'nojacket' ? jacketFix(song)
        : null;
      if (fix) {
        li.append(info, fix, actions);
        initComboboxes(fix);
      } else {
        li.append(info, actions);
      }
      return li;
    }

    function updateCounts() {
      for (const v of Object.keys(VIEWS) as View[]) {
        document.querySelector(`[data-count="${v}"]`)!.textContent = `(${songs.filter(VIEWS[v]).length})`;
      }
    }

    function render() {
      const view = currentView();
      updateCounts();
      viewNote.textContent = VIEW_NOTES[view];
      if (view === 'nomember' && !membersSupported) {
        viewNote.textContent += ' (Members aren\'t set up on this database yet: run migration 0002.)';
      }
      const q = searchKey(searchEl.value.trim());
      const shown = songs.filter((s) => VIEWS[view](s) && (!q || s.search.includes(q)));
      listEl.replaceChildren(...shown.map(row));
      emptyEl.hidden = !songs.length || !!shown.length;
      emptyEl.textContent = view === 'all' || q ? 'No songs match.' : 'Nothing to clean up here.';
    }

    async function removeSong(song: Song, button: HTMLButtonElement) {
      if (!supabase) return;
      const lost = song.scores
        ? `This also deletes its ${song.scores} score${song.scores === 1 ? '' : 's'} and ${song.attempts} attempt${song.attempts === 1 ? '' : 's'} in the history. This can't be undone.`
        : 'It has no scores. This can\'t be undone.';
      if (!confirm(`Remove "${song.titleJp}" from the song database?\n\n${lost}`)) return;
      button.disabled = true;
      status.textContent = `Removing "${song.titleJp}"...`;
      // Charts, scores and attempts go with the song (on delete cascade). RLS
      // turns a delete the account may not make into a silent no-op, so ask
      // for the removed row back and treat none as a failure.
      const { data, error } = await supabase.from('songs').delete().eq('id', song.id).select('id');
      if (error || !data?.length) {
        button.disabled = false;
        status.textContent = `Remove failed: ${error?.message ?? 'nothing was deleted (log in, and run db/holodori/migrations/0005_owner_song_deletes.sql)'}`;
        return;
      }
      await supabase.from('catalog_syncs').insert({});
      songs = songs.filter((s) => s.id !== song.id);
      status.textContent = `Removed "${song.titleJp}".`;
      render();
    }

    function syncUrl() {
      const url = new URL(location.href);
      const view = currentView();
      if (view === 'all') url.searchParams.delete('view');
      else url.searchParams.set('view', view);
      history.replaceState(null, '', url);
    }

    for (const input of viewInputs) {
      input.addEventListener('change', () => {
        // Clicking the selected view again goes back to All rather than none.
        if (!viewEl.value) viewEl.value = 'all';
        status.textContent = '';
        syncUrl();
        render();
      });
    }
    searchEl.addEventListener('input', render);

    const initial = new URLSearchParams(location.search).get('view');
    if (initial && initial in VIEWS) viewEl.value = initial;
    load();
  </script>
</Layout>
