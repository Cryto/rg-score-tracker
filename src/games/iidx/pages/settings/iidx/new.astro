---
import Layout from '@/layouts/Layout.astro';
import { CLEAR_LAMPS, LAMP_LABELS, LAMP_COLORS, LAMP_FILLS, LAMP_DARK_TEXT } from '../../../grade';

// Per-lamp button colors for the .choice-picker (see Layout.astro).
const lampStyle = (l: (typeof CLEAR_LAMPS)[number]) =>
  [`--choice:${LAMP_COLORS[l]}`, LAMP_FILLS[l] && `--choice-bg:${LAMP_FILLS[l]}`, LAMP_DARK_TEXT.has(l) && '--choice-on:#111']
    .filter(Boolean)
    .join(';');
---
<Layout title="Add Score" showLogout={true} showHome={true} settingsMode={true}>
  <a href="/settings" class="back-link">← Back to Settings</a>
  <h1>Add / Update Score</h1>
  <p id="auth-warning" style="display:none; color: #ff8080;">
    You're not logged in — <a href="/login">log in</a> to submit scores.
  </p>

  <form id="score-form" style="display:flex; flex-direction:column; gap:0.75rem; max-width:420px;">
    <div class="iidx-field">
      <label for="chart-search">Song / Chart</label>
      <div class="iidx-field-row">
        <input id="chart-search" type="text" placeholder="Type a song title..." autocomplete="off" />
        <button type="button" id="clear-chart" class="iidx-icon-btn" aria-label="Clear song/chart, EX score and BP" title="Clear song/chart, EX score and BP">✕</button>
        <button type="button" id="clear-all">Clear all</button>
      </div>
      <select id="chart-select" size="6" style="display:none;" aria-label="Matching charts"></select>
    </div>
    <label>EX Score <input id="ex-score" type="number" min="0" /></label>
    <fieldset class="choice-picker iidx-lamp-picker">
      <legend>Clear Lamp <span class="iidx-required">(required)</span></legend>
      {CLEAR_LAMPS.map((l) => (
        <label style={lampStyle(l)}>
          <input type="checkbox" name="clear-lamp" value={l} />
          <span>{LAMP_LABELS[l]}</span>
        </label>
      ))}
    </fieldset>
    <label>Miss Count (BP) <input id="miss-count" type="number" min="0" /></label>
    <button type="submit">Submit</button>
    <p id="status" style="color: var(--text-dim);"></p>
    <p style="color: var(--text-dim); font-size: 0.85rem;">
      Fields only ever improve — submitting a worse EX score, lamp, or miss count than
      your current best will not overwrite it.
    </p>
  </form>

  <section id="score-manager" class="score-manager" hidden></section>

  <style>
    .iidx-field { display: flex; flex-direction: column; gap: 0.25rem; }
    .iidx-field-row { display: flex; gap: 0.4rem; }
    .iidx-field-row input { flex: 1; min-width: 0; }
    .iidx-field-row button { flex-shrink: 0; white-space: nowrap; }
    .iidx-icon-btn { width: 2.2rem; padding: 0; border-color: var(--border); color: var(--text-dim); }
    .iidx-required { color: var(--text-dim); font-size: 0.85em; font-weight: normal; }
    /* Seven lamps don't fit one row: 4 + 3, in game order. */
    .iidx-lamp-picker { grid-auto-flow: row; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    /* Equal-height buttons whether or not a label wraps to two lines. */
    .iidx-lamp-picker label { display: flex; }
    .iidx-lamp-picker input + span {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      font-weight: 700;
    }
    .iidx-lamp-picker input:checked + span { text-shadow: none; }
  </style>

  <script>
    import { requireSupabase } from '@/lib/supabase';
    import { searchKey } from '@/lib/search';
    import { scoreManager } from '@/lib/score-manager';
    import { LAMP_LABELS } from '../../../grade';
    import { singleChoice } from '@/lib/choice';

    const supabase = requireSupabase('iidx');

    const authWarning = document.getElementById('auth-warning')!;
    const form = document.getElementById('score-form') as HTMLFormElement;
    const searchInput = document.getElementById('chart-search') as HTMLInputElement;
    const chartSelect = document.getElementById('chart-select') as HTMLSelectElement;
    const status = document.getElementById('status')!;
    const exScoreInput = document.getElementById('ex-score') as HTMLInputElement;
    const missCountInput = document.getElementById('miss-count') as HTMLInputElement;
    const clearLamp = singleChoice([...form.querySelectorAll<HTMLInputElement>('input[name="clear-lamp"]')]);

    let charts: { id: number; label: string; searchText: string }[] = [];
    let selectedChartId: number | null = null;
    const manager = scoreManager(document.getElementById('score-manager')!, {
      client: supabase,
      scoreColumns: 'ex_score, clear_lamp, miss_count',
      attemptColumns: 'ex_score, clear_lamp, miss_count',
      describe: (r) => [
        r.ex_score != null ? `EX ${r.ex_score}` : null,
        r.clear_lamp ? LAMP_LABELS[r.clear_lamp as keyof typeof LAMP_LABELS] : null,
        r.miss_count != null ? `BP ${r.miss_count}` : null,
      ].filter(Boolean).join(' · ') || '(empty)',
      migration: 'db/iidx/migrations/0008_owner_score_deletes.sql',
    });

    supabase.auth.getSession().then(({ data }) => {
      if (!data.session) authWarning.style.display = '';
    });

    async function loadCharts() {
      // Supabase caps a single select at 1000 rows - page through until exhausted.
      const pageSize = 1000;
      let data: any[] = [];
      for (let from = 0; ; from += pageSize) {
        const { data: page, error } = await supabase
          .from('charts')
          .select('id, play_style, difficulty, level, songs ( title, title_english )')
          .range(from, from + pageSize - 1);
        if (error) {
          status.textContent = `Failed to load songs: ${error.message}`;
          return;
        }
        data = data.concat(page ?? []);
        if (!page || page.length < pageSize) break;
      }
      charts = (data ?? []).map((c: any) => ({
        id: c.id,
        label: `${c.songs?.title ?? '?'} [${c.play_style} ${c.difficulty} Lv${c.level}]`,
        searchText: searchKey(`${c.songs?.title ?? ''} ${c.songs?.title_english ?? ''}`),
      }));
    }

    searchInput.addEventListener('input', () => {
      const q = searchKey(searchInput.value.trim());
      if (selectedChartId != null) manager.show(null);
      selectedChartId = null;
      if (!q) {
        chartSelect.style.display = 'none';
        chartSelect.innerHTML = '';
        return;
      }
      const matches = charts.filter((c) => c.searchText.includes(q)).slice(0, 50);
      chartSelect.innerHTML = matches
        .map((c) => `<option value="${c.id}">${c.label}</option>`)
        .join('');
      chartSelect.style.display = matches.length ? '' : 'none';
    });

    function clearChart() {
      searchInput.value = '';
      if (selectedChartId != null) manager.show(null);
      selectedChartId = null;
      chartSelect.style.display = 'none';
      chartSelect.innerHTML = '';
    }

    // The ✕ also clears the numbers typed for that song (the lamp stays).
    document.getElementById('clear-chart')!.addEventListener('click', () => {
      clearChart();
      exScoreInput.value = '';
      missCountInput.value = '';
      searchInput.focus();
    });

    document.getElementById('clear-all')!.addEventListener('click', () => {
      clearChart();
      exScoreInput.value = '';
      missCountInput.value = '';
      clearLamp.value = '';
      status.textContent = '';
      searchInput.focus();
    });

    chartSelect.addEventListener('change', () => {
      selectedChartId = Number(chartSelect.value);
      searchInput.value = chartSelect.selectedOptions[0]?.textContent ?? '';
      chartSelect.style.display = 'none';
      manager.show(selectedChartId, searchInput.value);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!selectedChartId) {
        status.textContent = 'Pick a song/chart from the dropdown first.';
        return;
      }
      const exScoreVal = exScoreInput.value;
      const missCountVal = missCountInput.value;
      const lamp = clearLamp.value;
      if (!lamp) {
        status.textContent = 'Pick a clear lamp.';
        return;
      }

      const { error } = await supabase.from('scores').upsert(
        {
          chart_id: selectedChartId,
          ex_score: exScoreVal ? Number(exScoreVal) : null,
          clear_lamp: lamp,
          miss_count: missCountVal ? Number(missCountVal) : null,
        },
        { onConflict: 'chart_id' }
      );

      status.textContent = error ? `Error: ${error.message}` : 'Saved.';
      if (!error) manager.show(selectedChartId, searchInput.value);
    });

    loadCharts();
  </script>
</Layout>
