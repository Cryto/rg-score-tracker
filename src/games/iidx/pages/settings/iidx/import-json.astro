---
import Layout from '@/layouts/Layout.astro';
---
<Layout title="Import Scores (JSON)" showLogout={true} showHome={true} settingsMode={true}>
  <a href="/settings" class="back-link">← Back to Settings</a>
  <h1>Import Scores from JSON Export</h1>
  <p id="auth-warning" style="display:none; color: #ff8080;">
    You're not logged in — <a href="/login">log in</a> to submit scores.
  </p>

  <p style="color: var(--text-dim); max-width: 700px;">
    Upload a <code>scores.json</code> export (the native score-export format, keyed by
    numeric song ID). Matched against the catalog via <code>songs.external_id</code> and
    any extra IDs in <code>song_external_ids</code> —
    songs not in the catalog are reported as unmatched, not inserted.
  </p>
  <p style="color: var(--text-dim); max-width: 700px;">
    Songs added from the Infinitas DB sheet don't have an INFINITAS ID yet. Unmatched IDs
    are listed after Preview with the songs they could be (same debut version, note counts
    that fit your scores): pick the right one and Link it, and its scores match from then on.
    A song that already has an ID (an INFINITAS original's 80xxx ID, say, when the
    export uses its arcade ID) keeps it and gets the new one as an extra ID.
  </p>

  <input id="json-file" type="file" accept="application/json,.json" />
  <div style="margin-top: 0.75rem; display:flex; flex-wrap:wrap; align-items:center; gap:0.75rem;">
    <button id="preview-btn" disabled>Preview</button>
    <button id="submit-btn" style="display:none;">Import Matched Scores</button>
    <span id="submit-status" class="submit-status" role="status"></span>
  </div>

  <div id="results" style="margin-top:1.5rem;"></div>
  <section id="link-section" hidden>
    <h2 style="font-size:1.05rem; margin: 1.5rem 0 0.25rem;">Link unmatched songs</h2>
    <p style="color: var(--text-dim); max-width: 700px; margin-top: 0;">
      The first two digits of an INFINITAS ID are the song's debut version. Suggestions are
      songs from that version with no INFINITAS ID whose charts have enough notes for your
      EX scores; search to pick any other song, including ones that already have an ID.
    </p>
    <ul id="link-list" class="link-list"></ul>
  </section>

  <!-- Global: the link rows are built from JS, which scoped styles can't reach. -->
  <style is:global>
    .link-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; max-width: 760px; }
    .link-row {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding: 0.6rem 0.75rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
    }
    .link-row small { color: var(--text-dim); }
    .link-fields { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .link-fields input { flex: 1 1 10rem; min-width: 0; }
    .link-fields select { flex: 2 1 16rem; min-width: 0; }
    .link-note { margin: 0; font-size: 0.85rem; color: var(--text-dim); min-height: 1em; }
    .link-note.error { color: #ff8080; }
  </style>

  <script>
    import { requireSupabase } from '@/lib/supabase';
    import { selectAll } from '@/lib/select-all';
    import { CLEAR_LAMPS, LAMP_LABELS } from '../../../grade';
    import { searchKey } from '@/lib/search';
    import { loadChartLookup as fetchChartLookup, matchScores, type ParsedScore, type UnmatchedChart } from '../../../score-export';

    const supabase = requireSupabase('iidx');

    const authWarning = document.getElementById('auth-warning')!;
    const fileInput = document.getElementById('json-file') as HTMLInputElement;
    const previewBtn = document.getElementById('preview-btn') as HTMLButtonElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const submitStatus = document.getElementById('submit-status')!;
    const results = document.getElementById('results')!;
    const linkSection = document.getElementById('link-section')!;
    const linkList = document.getElementById('link-list')!;

    let fileContent: any = null;
    let matched: ParsedScore[] = [];
    let chartLookup = new Map<string, number>();

    // Every song, for linking unmatched INFINITAS IDs to songs.
    type CatalogSong = {
      id: number; label: string; search: string; externalId: string | null; extraIds: string[];
      versionNumber: number | null; versionName: string | null;
      notes: Map<string, number | null>; // "SPA" -> note count
    };
    let catalog: CatalogSong[] = [];

    supabase.auth.getSession().then(({ data }) => {
      if (!data.session) authWarning.style.display = '';
    });

    async function loadChartLookup() {
      try {
        chartLookup = await fetchChartLookup(supabase);
      } catch (err: any) {
        results.innerHTML = `<p style="color:#ff8080;">${escapeHtml(err.message)}</p>`;
      }
    }

    async function loadCatalog() {
      let data: any[];
      try {
        data = await selectAll(supabase, 'songs', 'id, title, title_english, external_id, versions ( number, name ), charts ( play_style, difficulty, note_count )');
      } catch {
        return; // linking is optional; the import itself still works
      }
      const { data: extra } = await supabase.from('song_external_ids').select('external_id, song_id');
      catalog = data.map((s: any) => ({
        id: s.id,
        label: s.title_english && s.title_english !== s.title ? `${s.title} (${s.title_english})` : s.title,
        search: searchKey(`${s.title ?? ''} ${s.title_english ?? ''}`),
        externalId: s.external_id,
        extraIds: (extra ?? []).filter((e: any) => e.song_id === s.id).map((e: any) => e.external_id),
        versionNumber: s.versions?.number ?? null,
        versionName: s.versions?.name ?? null,
        notes: new Map((s.charts ?? []).map((c: any) => [`${c.play_style}${c.difficulty}`, c.note_count])),
      }));
    }

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      previewBtn.disabled = !file;
      submitBtn.style.display = 'none';
      submitStatus.innerHTML = '';
      results.innerHTML = '';
      fileContent = null;
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try {
          fileContent = JSON.parse(reader.result as string);
        } catch (err: any) {
          results.innerHTML = `<p style="color:#ff8080;">Invalid JSON: ${err.message}</p>`;
        }
      };
      reader.readAsText(file);
    });

    previewBtn.addEventListener('click', () => {
      if (!fileContent) return;

      const result = matchScores(fileContent, chartLookup);
      matched = result.matched;
      const { unmatched, unmatchedSongs, noPlayCount } = result;

      results.innerHTML = `
        <p><strong>${matched.length}</strong> chart score(s) matched and ready to import.</p>
        <p style="color: var(--text-dim);">${noPlayCount} chart(s) with no play (clear_type 0) skipped.</p>
        ${unmatched.length ? `<p style="color:#ffb066;">${unmatched.length} chart(s) had no matching song/chart in the catalog (external_id not found):</p><pre>${unmatched.slice(0, 100).join('\n')}${unmatched.length > 100 ? `\n… and ${unmatched.length - 100} more` : ''}</pre>` : ''}
      `;
      submitStatus.innerHTML = '';
      submitBtn.style.display = matched.length ? '' : 'none';
      renderLinks(unmatchedSongs);
    });

    function escapeHtml(s: string) {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    }

    // A song fits an unmatched ID when it debuted in the ID's version and
    // every played chart exists with enough notes for its EX score (EX is at
    // most 2 per note). Unknown note counts don't rule a song out.
    function fits(song: CatalogSong, versionNumber: number, charts: UnmatchedChart[]) {
      if (song.externalId || song.versionNumber !== versionNumber) return false;
      return charts.every(({ code, score }) => {
        if (!song.notes.has(code)) return false;
        const notes = song.notes.get(code);
        return notes == null || !score.ex_score || score.ex_score <= notes * 2;
      });
    }

    function renderLinks(unmatchedSongs: Map<string, UnmatchedChart[]>) {
      linkList.replaceChildren(...[...unmatchedSongs].map(([externalId, charts]) => linkRow(externalId, charts)));
      linkSection.hidden = !unmatchedSongs.size;
    }

    function linkRow(externalId: string, charts: UnmatchedChart[]) {
      const versionNumber = Number(externalId.slice(0, 2));
      const versionName = catalog.find((s) => s.versionNumber === versionNumber)?.versionName ?? `version ${versionNumber}`;
      const played = charts
        .map(({ code, score }) => [code, score.ex_score ? `EX ${score.ex_score}` : null, score.clear_type ? LAMP_LABELS[CLEAR_LAMPS[score.clear_type - 1]] : null].filter(Boolean).join(' '))
        .join(' · ');
      const suggestions = catalog.filter((s) => fits(s, versionNumber, charts)).sort((a, b) => a.label.localeCompare(b.label));

      const li = document.createElement('li');
      li.className = 'link-row';
      li.innerHTML = `<div><strong>INFINITAS ID ${escapeHtml(externalId)}</strong> <small>debuted in ${escapeHtml(versionName)}</small></div>
        <small>Your scores: ${escapeHtml(played)}</small>
        <div class="link-fields">
          <input type="search" placeholder="Search other songs..." autocomplete="off" aria-label="Search songs for ID ${escapeHtml(externalId)}" />
          <select aria-label="Song for ID ${escapeHtml(externalId)}"></select>
          <button type="button">Link</button>
        </div>
        <p class="link-note"></p>`;
      const search = li.querySelector('input')!;
      const select = li.querySelector('select')!;
      const button = li.querySelector('button')!;
      const note = li.querySelector<HTMLElement>('.link-note')!;

      function fill(options: CatalogSong[], placeholder: string) {
        const optionLabel = (s: CatalogSong) => {
          const ids = [s.externalId, ...s.extraIds].filter(Boolean);
          return ids.length ? `${s.label} [has ID ${ids.join(', ')}]` : s.label;
        };
        select.replaceChildren(new Option(placeholder, ''), ...options.slice(0, 100).map((s) => new Option(optionLabel(s), String(s.id))));
        button.disabled = true;
      }
      const showSuggestions = () => fill(suggestions, suggestions.length ? `${suggestions.length} suggestion${suggestions.length === 1 ? '' : 's'}...` : 'No suggestions: search instead');
      showSuggestions();
      search.addEventListener('input', () => {
        const q = searchKey(search.value.trim());
        if (!q) return showSuggestions();
        // Songs without an ID first: they are the likelier match.
        const hits = catalog
          .filter((s) => s.search.includes(q))
          .sort((a, b) => Number(!!a.externalId) - Number(!!b.externalId) || a.label.localeCompare(b.label));
        fill(hits, hits.length ? `${hits.length} match${hits.length === 1 ? '' : 'es'}...` : 'No songs match');
      });
      select.addEventListener('change', () => (button.disabled = !select.value));

      button.addEventListener('click', async () => {
        const song = catalog.find((s) => s.id === Number(select.value));
        if (!song) return;
        button.disabled = true;
        note.classList.remove('error');
        note.textContent = 'Linking...';
        // A song with no ID takes this one as its main ID; a song that has one
        // keeps it and gets this one as an extra ID. RLS turns a write the
        // account may not make into a silent no-op, so ask for the row back
        // and treat none as a failure.
        const { data, error } = song.externalId
          ? await supabase.from('song_external_ids').insert({ external_id: externalId, song_id: song.id }).select('song_id')
          : await supabase.from('songs').update({ external_id: externalId }).eq('id', song.id).select('id');
        if (error || !data?.length) {
          note.textContent = `Not linked: ${error?.message ?? 'log in first'}`;
          note.classList.add('error');
          button.disabled = false;
          return;
        }
        if (song.externalId) song.extraIds.push(externalId);
        else song.externalId = externalId;
        note.textContent = `Linked to ${song.label}.`;
        search.disabled = select.disabled = true;
        // Re-match so this song's scores join the import on the next Preview.
        await loadChartLookup();
        submitBtn.style.display = 'none';
        submitStatus.innerHTML = '<span style="color: var(--text-dim);">Song linked. Press Preview again to include its scores.</span>';
      });
      return li;
    }


    submitBtn.addEventListener('click', async () => {
      submitBtn.disabled = true;
      submitStatus.innerHTML = 'Importing…';
      const { error } = await supabase.from('scores').upsert(matched, { onConflict: 'chart_id' });
      submitStatus.innerHTML = error
        ? `<span style="color:#ff8080;">Import failed: ${error.message}</span>`
        : `<span style="color:#8fd18f;">Imported ${matched.length} score(s).</span>`;
      submitBtn.disabled = false;
    });

    loadChartLookup();
    loadCatalog();
  </script>
</Layout>
