---
import Layout from '@/layouts/Layout.astro';
---
<Layout title="IIDX Score Tracker">
  <div class="page-header">
    <h1>beatmania IIDX Score Tracker</h1>
    <div id="last-updated" class="last-updated"></div>
  </div>

  <div class="layout">
    <aside class="filters-sidebar" id="filters-sidebar">
      <button type="button" id="sidebar-close-btn" class="sidebar-close-btn" aria-label="Close filters">✕</button>
      <div class="filters-heading">View</div>
      <div class="view-toggle iidx-view-toggle">
        <button type="button" class="view-btn active" data-view="list">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          List
        </button>
        <button type="button" class="view-btn" data-view="stats">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          Statistics
        </button>
        <button type="button" class="view-btn" data-view="song">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
          Song
        </button>
        <button type="button" class="view-btn" data-view="tier">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
          Tier
        </button>
      </div>

      <!-- Tier view sidebar: which table, which of its lamps' lists, and a jump list of its tiers. -->
      <div id="tier-sidebar" hidden>
        <div class="tier-side-group">
          <div class="filters-heading">Tables</div>
          <div id="tier-tables" class="tier-table-groups"></div>
        </div>
        <div class="tier-side-group">
          <div class="filters-heading">Clear</div>
          <div id="tier-lamps" class="tier-pick-list"></div>
        </div>
        <div class="tier-side-group">
          <div class="filters-heading">Tiers</div>
          <div id="tier-tiers" class="tier-side-tiers"></div>
        </div>
      </div>

      <div id="filters-section">
      <!-- Play style sits above the filters as two toggle buttons; neither on means both. -->
      <div class="filters-heading">Play Style</div>
      <div class="style-toggle" data-group="style">
        <label class="style-btn"><input type="checkbox" value="SP" /> Single</label>
        <label class="style-btn"><input type="checkbox" value="DP" /> Double</label>
      </div>

      <div class="filters-heading">Filters</div>
      <button type="button" id="reset-filters-btn" class="reset-filters-btn">Reset filters</button>

      <div class="filter-group" data-group="difficulty">
        <button type="button" class="filter-group-header">Difficulty<span class="arrow">▸</span></button>
        <div class="filter-group-content">
          <label class="checkbox-row"><input type="checkbox" value="B" /> Beginner</label>
          <label class="checkbox-row"><input type="checkbox" value="N" /> Normal</label>
          <label class="checkbox-row"><input type="checkbox" value="H" /> Hyper</label>
          <label class="checkbox-row"><input type="checkbox" value="A" /> Another</label>
          <label class="checkbox-row"><input type="checkbox" value="L" /> Leggendaria</label>
        </div>
      </div>

      <div class="filter-group" data-group="grade">
        <button type="button" class="filter-group-header">Grade<span class="arrow">▸</span></button>
        <div class="filter-group-content">
          <label class="checkbox-row"><input type="checkbox" value="MAX" /> MAX</label>
          <label class="checkbox-row"><input type="checkbox" value="MAX-" /> MAX<span class="grade-minus" aria-label="minus">−</span></label>
          <label class="checkbox-row"><input type="checkbox" value="AAA" /> AAA</label>
          <label class="checkbox-row"><input type="checkbox" value="AA" /> AA</label>
          <label class="checkbox-row"><input type="checkbox" value="A" /> A</label>
          <label class="checkbox-row"><input type="checkbox" value="B" /> B</label>
          <label class="checkbox-row"><input type="checkbox" value="C" /> C</label>
          <label class="checkbox-row"><input type="checkbox" value="D" /> D</label>
          <label class="checkbox-row"><input type="checkbox" value="E" /> E</label>
          <label class="checkbox-row"><input type="checkbox" value="F" /> F</label>
          <label class="checkbox-row"><input type="checkbox" value="—" /> No grade</label>
        </div>
      </div>

      <div class="filter-group" data-group="lamp">
        <button type="button" class="filter-group-header">Clear Lamp<span class="arrow">▸</span></button>
        <div class="filter-group-content">
          <label class="checkbox-row"><input type="checkbox" value="FULL_COMBO" /> Full Combo</label>
          <label class="checkbox-row"><input type="checkbox" value="EX_HARD_CLEAR" /> EX Hard Clear</label>
          <label class="checkbox-row"><input type="checkbox" value="HARD_CLEAR" /> Hard Clear</label>
          <label class="checkbox-row"><input type="checkbox" value="CLEAR" /> Clear</label>
          <label class="checkbox-row"><input type="checkbox" value="EASY_CLEAR" /> Easy Clear</label>
          <label class="checkbox-row"><input type="checkbox" value="ASSIST_CLEAR" /> Assist Clear</label>
          <label class="checkbox-row"><input type="checkbox" value="FAILED" /> Failed</label>
          <label class="checkbox-row"><input type="checkbox" value="NONE" /> No score yet</label>
        </div>
      </div>

      <div class="filter-group" data-group="level">
        <button type="button" class="filter-group-header">Level<span class="arrow">▸</span></button>
        <div class="filter-group-content">
          {Array.from({ length: 12 }, (_, i) => i + 1).map((lv) => (
            <label class="checkbox-row"><input type="checkbox" value={lv} /> Lv. {lv}</label>
          ))}
        </div>
      </div>

      <div class="filter-group" data-group="version">
        <button type="button" class="filter-group-header">Version<span class="arrow">▸</span></button>
        <div class="filter-group-content" id="f-version-list"></div>
      </div>

      <div class="filter-group" data-group="playable-in">
        <button type="button" class="filter-group-header">Playable In<span class="arrow">▸</span></button>
        <div class="filter-group-content" id="f-playable-in-list"></div>
      </div>

      <div class="filters-heading options-heading">Options</div>
      <label class="checkbox-row"><input type="checkbox" id="opt-show-pct" /> Show %</label>
      </div>
    </aside>

    <div class="table-container">
      <div class="table-toolbar">
        <button type="button" id="filters-toggle-btn" class="filters-toggle-btn" aria-label="Toggle filters">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="18" x2="20" y2="18"></line></svg>
          Filters
        </button>
        <label class="search-row">Search
          <input id="f-search" type="text" placeholder="Song title..." />
        </label>
      </div>

      <p id="status" style="color: var(--text-dim);">Loading...</p>

      <div class="table-scroll">
        <table id="chart-table" style="display:none;">
          <colgroup>
            <col class="col-title" />
            <col class="col-chart" />
            <col class="col-ex hide-mobile" />
            <col class="col-grade" />
            <col class="col-lamp hide-mobile" />
            <col class="col-bp hide-mobile" />
          </colgroup>
          <thead>
            <tr>
              <th>Title</th>
              <th>Chart</th>
              <th class="hide-mobile">EX Score</th>
              <th>Grade</th>
              <th class="hide-mobile">Lamp</th>
              <th class="hide-mobile">BP</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
        <div id="table-sentinel"></div>
      </div>

      <div id="song-container" style="display:none;"></div>
      <div id="stats-container" style="display:none;"></div>
      <div id="tier-container" style="display:none;"></div>
    </div>
  </div>

  <div id="sidebar-backdrop" class="sidebar-backdrop"></div>

  <!-- Global: the stats tables are built from JS, which scoped styles can't reach. -->
  <style is:global>
    /* MAX-'s minus, drawn bigger and bolder so it can't be missed. */
    .grade-minus { display: inline-block; margin-left: 0.08em; font-size: 1.3em; font-weight: 900; line-height: 0; vertical-align: -0.04em; }
    /* Stats tables: every level column is the same fixed width (set by the
       <colgroup> from JS), so a 3-digit count doesn't stretch its column. */
    #stats-container .pivot-table { table-layout: fixed; }
    #stats-container .pivot-table td,
    #stats-container .pivot-table thead th:not(:first-child) { text-align: center; padding-left: 0; padding-right: 0; }
    .iidx-count { color: inherit; text-decoration: none; display: block; border-radius: 4px; }
    .iidx-count:focus-visible { outline: 2px solid var(--accent); }
    @media (hover: hover) { .iidx-count:hover { background: var(--border); text-decoration: underline; } }
    /* RemyWiki link at the end of the expanded record. */
    .expand-row .wiki-link {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 0.85rem;
      color: var(--accent);
      text-decoration: none;
      white-space: nowrap;
    }
    .expand-row .wiki-link svg { width: 14px; height: 14px; }
    .expand-row .wiki-link:hover { text-decoration: underline; }
    .iidx-lamp-dot {
      display: inline-block;
      width: 0.7rem;
      height: 0.7rem;
      margin-right: 0.3rem;
      border-radius: 50%;
      vertical-align: -0.05rem;
      background: var(--lamp);
    }

    /* Song-select clear lamp: a bar down the left edge of each record, with
       the in-game colours and flashing. */
    #chart-table .title-cell { position: relative; padding-left: calc(0.6rem + 9px); }
    .iidx-lamp {
      position: absolute;
      left: 3px;
      top: 3px;
      bottom: 3px;
      width: 6px;
      border-radius: 2px;
      background: #3a3a40;
    }
    .iidx-lamp[data-lamp="FAILED"] { animation: iidx-lamp-failed 0.5s infinite; }
    .iidx-lamp[data-lamp="ASSIST_CLEAR"] { background: #b26bff; box-shadow: 0 0 5px #b26bff99; }
    .iidx-lamp[data-lamp="EASY_CLEAR"] { background: #7cff4a; box-shadow: 0 0 5px #7cff4a99; }
    .iidx-lamp[data-lamp="CLEAR"] { background: #2b8fff; box-shadow: 0 0 5px #2b8fff99; }
    .iidx-lamp[data-lamp="HARD_CLEAR"] { background: #ffffff; box-shadow: 0 0 5px #ffffffaa; }
    .iidx-lamp[data-lamp="EX_HARD_CLEAR"] { animation: iidx-lamp-exhard 0.3s infinite; }
    .iidx-lamp[data-lamp="FULL_COMBO"] {
      background: linear-gradient(180deg, #ff3b3b, #ffb13b, #fff23b, #4dff6a, #3be8ff, #4a6bff, #c64dff, #ff3b3b);
      box-shadow: 0 0 5px #ffffff88;
      animation: iidx-lamp-rainbow 1s linear infinite;
    }
    /* Failed blinks red on and off. */
    @keyframes iidx-lamp-failed {
      0%, 49% { background: #ff2b2b; box-shadow: 0 0 6px #ff2b2bcc; }
      50%, 100% { background: #4a1014; box-shadow: none; }
    }
    /* EX Hard Clear cycles red, orange and yellow. */
    @keyframes iidx-lamp-exhard {
      0%, 32% { background: #ff2b2b; box-shadow: 0 0 6px #ff2b2bcc; }
      33%, 65% { background: #ff8a1c; box-shadow: 0 0 6px #ff8a1ccc; }
      66%, 100% { background: #ffe23b; box-shadow: 0 0 6px #ffe23bcc; }
    }
    /* Full Combo cycles through the rainbow. */
    @keyframes iidx-lamp-rainbow {
      from { filter: hue-rotate(0deg); }
      to { filter: hue-rotate(360deg); }
    }
    /* View switcher as a 2×2 grid, so Song sits under List. Two classes so it
       beats the shared .view-toggle flex rule, whose stylesheet loads later. */
    .view-toggle.iidx-view-toggle { display: grid; grid-template-columns: 1fr 1fr; }
    /* Play style toggle buttons (checkboxes underneath; neither on = both). */
    .style-toggle { display: flex; gap: 0.5rem; margin-bottom: 1.25rem; }
    .style-btn {
      flex: 1;
      display: flex;
      justify-content: center;
      padding: 0.45rem 0.3rem;
      font-size: 0.85rem;
      color: var(--text-dim);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      cursor: pointer;
      user-select: none;
    }
    .style-btn input { position: absolute; opacity: 0; pointer-events: none; }
    .style-btn:has(input:checked) { color: var(--text); border-color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, var(--surface)); }
    .style-btn:has(input:focus-visible) { outline: 2px solid var(--accent); }
    @media (hover: hover) { .style-btn:hover { color: var(--text); } }
    .options-heading { margin-top: 1.25rem; }

    /* ---- Song view ---- */
    .sv-header, .sv-song {
      display: grid;
      grid-template-columns: minmax(0, 1fr) repeat(5, 124px);
      gap: 0.45rem;
      align-items: stretch;
    }
    .sv-header {
      position: sticky;
      top: calc(var(--header-sticky-height, 0px) + var(--toolbar-height, 0px));
      z-index: 10;
      background: var(--bg);
      padding: 0.4rem 0.5rem;
      border-bottom: 1px solid var(--border);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--text-dim);
    }
    .sv-song { padding: 0.45rem 0.5rem; border-bottom: 1px solid var(--border); }
    .sv-head { display: flex; align-items: center; gap: 0.6rem; min-width: 0; cursor: pointer; border-radius: 6px; padding: 0.2rem; }
    .sv-head:focus-visible, .sv-head[aria-expanded="true"] { outline: 2px solid var(--accent); }
    @media (hover: hover) { .sv-head:hover .sv-title-main { color: var(--accent); } }
    .sv-title { min-width: 0; }
    .sv-title-main { font-weight: 600; overflow-wrap: anywhere; }
    .sv-style { flex-shrink: 0; font-size: 0.7rem; font-weight: 800; padding: 0.15rem 0.35rem; border-radius: 4px; color: #fff; }
    .sv-style-SP { background: #2f6fc4; }
    .sv-style-DP { background: #c0392b; }
    .sv-charts { display: contents; }
    /* A difficulty cell, colored like the in-game difficulty label. */
    .sv-chart {
      position: relative;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas: "level ex" "level grade";
      column-gap: 0.45rem;
      align-items: center;
      padding: 0.35rem 0.45rem 0.6rem;
      min-height: 50px;
      min-width: 0;
      border-radius: 6px;
      background: linear-gradient(135deg, color-mix(in srgb, var(--diff) 26%, var(--surface)), var(--surface) 75%);
      border: 1px solid color-mix(in srgb, var(--diff) 45%, var(--border));
      cursor: pointer;
    }
    .sv-chart.unplayed { background: var(--surface); border-color: color-mix(in srgb, var(--diff) 25%, var(--border)); }
    .sv-chart.dim { opacity: 0.3; }
    .sv-chart:focus-visible, .sv-chart[aria-expanded="true"] { outline: 2px solid var(--diff); outline-offset: 1px; }
    @media (hover: hover) { .sv-chart[data-chart-id]:hover { border-color: var(--diff); } }
    .sv-none { background: none; border: 1px dashed var(--border); cursor: default; }
    .sv-diff-name { display: none; }
    .sv-level {
      grid-area: level;
      min-width: 1.9rem;
      padding: 0.15rem 0.3rem;
      border-radius: 5px;
      background: var(--diff);
      color: #fff;
      font-weight: 900;
      text-align: center;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
    }
    .sv-ex { grid-area: ex; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 0.8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sv-grade small { margin-left: 0.35rem; color: var(--text-dim); font-size: 0.7rem; font-weight: 500; }
    .sv-chart.unplayed .sv-ex { color: var(--text-dim); }
    .sv-grade { grid-area: grade; font-size: 0.8rem; font-weight: 800; }
    /* The song-select lamp, as a strip along the cell's bottom edge. */
    .sv-chart .iidx-lamp { top: auto; left: 6px; right: 6px; bottom: 3px; width: auto; height: 4px; }
    .sv-panel {
      grid-column: 1 / -1;
      margin: 0;
      padding: 0.5rem 0.75rem;
      border-radius: 6px;
      background: var(--surface);
      border-left: 3px solid var(--diff, var(--accent));
      font-size: 0.85rem;
    }
    .sv-info { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 1.5rem; color: var(--text-dim); }
    .sv-info strong { color: var(--text); font-weight: 500; }
    .sv-info .wiki-link { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--accent); text-decoration: none; }
    .sv-info .wiki-link svg { width: 14px; height: 14px; }
    .sv-notes { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; }
    .sv-note { border-left: 3px solid var(--diff); padding-left: 0.35rem; }
    .sv-count { color: var(--text-dim); font-size: 0.8rem; }
    /* Narrow: the title takes its own line and the cells wrap underneath. */
    @media (max-width: 1100px) {
      .sv-header { display: none; }
      .sv-song { grid-template-columns: minmax(0, 1fr); gap: 0.4rem; padding: 0.6rem 0.15rem; container-type: inline-size; }
      .sv-charts { display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); gap: 0.35rem; }
      @container (min-width: 600px) {
        .sv-charts { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); }
      }
      .sv-none { display: none; }
      .sv-diff-name {
        display: block;
        grid-area: name;
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--diff);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .sv-chart { grid-template-areas: "name name" "level ex" "level grade"; }
    }

    /* ---- Tier view ---- */
    .tier-pick-list { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1.25rem; }
    .tier-pick {
      padding: 0.35rem 0.6rem;
      font-size: 0.8rem;
      color: var(--text-dim);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
    }
    .tier-pick.active { color: var(--text); border-color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, var(--surface)); }
    .tier-lamp-pick.active { color: var(--lamp-text); font-weight: 600; border-color: transparent; background: var(--lamp-fill); }
    .tier-side-tiers { display: flex; flex-direction: column; margin-bottom: 1.25rem; }
    .tier-table-groups { margin-bottom: 1.25rem; }
    .tier-table-group .filter-group-content { gap: 0; max-height: none; padding-bottom: 0.5rem; }
    .tier-table-row.active { background: color-mix(in srgb, var(--accent) 14%, var(--surface)); box-shadow: inset 2px 0 0 var(--accent); }
    .tier-side-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.3rem 0.4rem;
      font-size: 0.85rem;
      color: var(--text);
      background: none;
      border: none;
      border-radius: 4px;
      text-align: left;
    }
    @media (hover: hover) { .tier-side-row:hover { background: var(--surface); } }
    .tier-side-count { font-size: 0.75rem; color: var(--text-dim); background: var(--surface); border: 1px solid var(--border); border-radius: 4px; padding: 0 0.4rem; min-width: 2rem; text-align: center; }

    #tier-container { min-width: 0; }
    .tier-empty { color: var(--text-dim); }
    .tier-dim { color: var(--text-dim); }
    .tier-summary { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 0.75rem 1.5rem; margin-bottom: 1rem; }
    .tier-summary-title h2 { font-size: 1.2rem; margin: 0; }
    .tier-summary-lamp { font-size: 0.8rem; color: var(--text-dim); }
    .tier-stats { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
    .tier-stats > div { display: flex; flex-direction: column; }
    .tier-stat-label { font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-dim); }
    .tier-stat-value { font-size: 1.15rem; font-weight: 700; color: #f2c14e; }
    .tier-stat-value small { font-size: 0.8rem; font-weight: 500; }

    /* Overview graph: one stacked bar per tier; click jumps to its section. */
    .tier-graph {
      display: flex;
      flex-direction: column;
      gap: 3px;
      padding: 0.75rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    .tier-graph-row {
      display: grid;
      grid-template-columns: 5.5rem 1fr 4.5rem;
      align-items: center;
      gap: 0.6rem;
      padding: 2px 0.25rem;
      font: inherit;
      color: var(--text);
      background: none;
      border: none;
      border-radius: 4px;
      text-align: left;
      cursor: pointer;
    }
    @media (hover: hover) { .tier-graph-row:hover { background: var(--border); } }
    .tier-graph-row:focus-visible { outline: 2px solid var(--accent); }
    .tier-graph-label { font-size: 0.8rem; color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tier-graph-bar { display: flex; height: 14px; border-radius: 3px; overflow: hidden; background: #3a3d46; }
    .tier-seg { height: 100%; }
    .tier-seg + .tier-seg { box-shadow: inset 1px 0 0 rgba(0, 0, 0, 0.35); }
    .tier-graph-value { font-size: 0.75rem; color: var(--text-dim); text-align: right; font-variant-numeric: tabular-nums; }
    .tier-legend { display: flex; flex-wrap: wrap; gap: 0.35rem 0.9rem; margin: 0.6rem 0 1.5rem; font-size: 0.75rem; color: var(--text-dim); }
    .tier-legend i { display: inline-block; width: 0.75rem; height: 0.75rem; border-radius: 2px; margin-right: 0.3rem; vertical-align: -0.1rem; }
    .tier-tooltip {
      position: fixed;
      left: 0;
      top: 0;
      z-index: 300;
      pointer-events: none;
      min-width: 12rem;
      padding: 0.5rem 0.65rem;
      font-size: 0.78rem;
      color: var(--text);
      background: #0b0d11ee;
      border: 1px solid var(--border);
      border-radius: 6px;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5);
    }
    .tier-tooltip-title { font-weight: 700; margin-bottom: 0.3rem; }
    .tier-tooltip-title span { font-weight: 400; color: var(--text-dim); margin-left: 0.4rem; }
    .tier-tooltip-row { display: grid; grid-template-columns: 0.8rem 1fr auto 3.2rem; gap: 0.4rem; align-items: center; }
    .tier-tooltip-row.zero { color: var(--text-dim); }
    .tier-tooltip-row i { width: 0.7rem; height: 0.7rem; border-radius: 2px; }
    .tier-tooltip-row span:last-child { text-align: right; font-variant-numeric: tabular-nums; }

    /* Tier sections and chart cards. */
    .tier-section { margin-bottom: 1.25rem; scroll-margin-top: calc(var(--header-sticky-height, 0px) + var(--toolbar-height, 0px) + 0.5rem); }
    .tier-section-head { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; }
    .tier-section-head h3 { margin: 0; font-size: 1.05rem; color: #f2c14e; }
    .tier-badge { font-size: 0.75rem; font-weight: 700; color: #f2c14e; background: #3a2f12; border-radius: 999px; padding: 0.2rem 0.6rem; white-space: nowrap; }
    .tier-badge.done { color: #9bf59b; background: #17361c; }
    .tier-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 0.4rem; }
    .tier-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      padding: 0.45rem 0.55rem 0.45rem 0.75rem;
      background: color-mix(in srgb, var(--lamp) 13%, var(--surface));
      border: 1px solid color-mix(in srgb, var(--lamp) 30%, var(--border));
      border-radius: 6px;
      cursor: pointer;
      min-width: 0;
    }
    .tier-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; border-radius: 6px 0 0 6px; background: var(--lamp); }
    .tier-card[data-lamp="FULL_COMBO"]::before { background: linear-gradient(180deg, #FF8A8A, #FFD36E, #9BF59B, #7FD8FF, #C59BFF); }
    .tier-card[data-lamp="NO_PLAY"] { background: var(--surface); border-color: var(--border); }
    .tier-card:focus-visible { outline: 2px solid var(--accent); }
    @media (hover: hover) { .tier-card:hover { border-color: var(--lamp); } }
    .tier-card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.4rem; }
    .tier-card-title { font-size: 0.85rem; font-weight: 600; line-height: 1.25; overflow-wrap: anywhere; }
    .tier-card-title small { font-weight: 400; color: var(--text-dim); }
    .tier-card-meta { display: flex; justify-content: space-between; gap: 0.4rem; font-size: 0.72rem; color: var(--text-dim); }
    .tier-card-lamp { font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; color: var(--lamp); }
    .tier-card[data-lamp="NO_PLAY"] .tier-card-lamp { color: var(--text-dim); font-weight: 400; }
    .tier-card-score { display: none; flex-wrap: wrap; gap: 0.2rem 0.75rem; padding-top: 0.3rem; border-top: 1px solid var(--border); font-size: 0.78rem; }
    .tier-card-score b { font-weight: 600; color: var(--text-dim); margin-right: 0.2rem; }
    .tier-card-score small { color: var(--text-dim); }
    .tier-card.open .tier-card-score { display: flex; }
    .tier-chip { flex-shrink: 0; font-size: 0.68rem; font-weight: 700; padding: 0.05rem 0.35rem; border-radius: 4px; color: #fff; }
    .tier-chip.chip-B { background: #3f8f3a; }
    .tier-chip.chip-N { background: #2f6fc4; }
    .tier-chip.chip-H { background: #b8860b; }
    .tier-chip.chip-A { background: #c0392b; }
    .tier-chip.chip-L { background: #7b3fc4; }
    @media (max-width: 768px) {
      .tier-graph { padding: 0.5rem; }
      .tier-graph-row { grid-template-columns: 4.5rem 1fr 3.75rem; gap: 0.4rem; }
      .tier-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr)); }
    }

    @media (prefers-reduced-motion: reduce) {
      .iidx-lamp { animation: none !important; }
      .iidx-lamp[data-lamp="FAILED"] { background: #ff2b2b; }
      .iidx-lamp[data-lamp="EX_HARD_CLEAR"] { background: linear-gradient(180deg, #ff2b2b, #ff8a1c, #ffe23b); }
    }
  </style>

  <script>
    import { requireSupabase } from '@/lib/supabase';
    import { computeGrade, gradeHtml, LAMP_LABELS, LAMP_COLORS, LAMP_FILLS, type ClearLamp } from '../grade';
    import { searchKey } from '@/lib/search';
    import { loadAttempts, historyHtml } from '@/lib/history';
    import { TierView, type TierData, type TierViewState, type TargetLamp } from '../tier-view';
    import { songRecords, songRecordHtml, songInfoHtml, exPercent, DIFF_COLORS, DIFF_NAMES, type SongRecord } from '../song-view';

    const supabase = requireSupabase('iidx');

    const DIFF_LABELS: Record<string, string> = {
      B: 'Beginner', N: 'Normal', H: 'Hyper', A: 'Another', L: 'Leggendaria',
    };
    const STYLE_LABELS: Record<string, string> = { SP: 'Single Play', DP: 'Double Play' };
    const DIFF_ORDER = ['B', 'N', 'H', 'A', 'L'];
    const GRADE_ORDER = ['MAX', 'MAX-', 'AAA', 'AA', 'A', 'B', 'C', 'D', 'E', 'F'];
    const LAMP_ORDER = ['FULL_COMBO', 'EX_HARD_CLEAR', 'HARD_CLEAR', 'CLEAR', 'EASY_CLEAR', 'ASSIST_CLEAR', 'FAILED', 'NONE'];
    const LAMP_ROW_LABELS: Record<string, string> = { ...LAMP_LABELS, NONE: 'No score yet' };

    type ViewMode = 'list' | 'song' | 'stats' | 'tier';
    let viewMode: ViewMode = 'list';
    // Built the first time the Tier view opens (its data is loaded on demand).
    let tierView: TierView | null = null;
    let tierState: Partial<TierViewState> = {};
    let loaded = false;
    const ROW_BATCH = 200;
    let listRows: Row[] = [];
    let renderedCount = 0;
    // Song view: records are rendered in batches like the list.
    const SONG_BATCH = 100;
    let songRecs: SongRecord<Row>[] = [];
    let songInFilter = new Set<number>();
    let songRenderedCount = 0;

    // "Show %" (Options) is a viewer preference, so it's remembered per browser.
    const showPctEl = document.getElementById('opt-show-pct') as HTMLInputElement;
    try { showPctEl.checked = localStorage.getItem('iidx-show-pct') === '1'; } catch {}
    showPctEl.addEventListener('input', () => {
      try { localStorage.setItem('iidx-show-pct', showPctEl.checked ? '1' : '0'); } catch {}
      render();
    });
    // EX score with its % of max underneath when Show % is on.
    function exHtml(exScore: number | null, noteCount: number | null): string {
      const pct = showPctEl.checked ? exPercent(exScore, noteCount) : null;
      return `${exScore ?? '—'}${pct ? `<div class="row-subtitle">${pct}</div>` : ''}`;
    }

    type Row = {
      chartId: number;
      songId: number;
      version: string;
      versionKey: number;
      title: string;
      titleEnglish: string;
      artist: string;
      wikiUrl: string | null;
      style: string;
      difficulty: string;
      level: number;
      noteCount: number | null;
      bpmMin: number | null;
      bpmMax: number | null;
      chartLabel: string | null;
      exScore: number | null;
      lamp: string | null;
      missCount: number | null;
      scoreUpdatedAt: string | null;
      playableIn: string[];
      searchText: string;
    };

    let rows: Row[] = [];

    const statusEl = document.getElementById('status')!;
    const tableEl = document.getElementById('chart-table')!;
    const tbody = tableEl.querySelector('tbody')!;
    const statsContainerEl = document.getElementById('stats-container')!;
    const songContainerEl = document.getElementById('song-container')!;
    const tierContainerEl = document.getElementById('tier-container')!;
    const tierSidebarEl = document.getElementById('tier-sidebar')!;
    const filtersSectionEl = document.getElementById('filters-section')!;
    const versionListEl = document.getElementById('f-version-list')!;
    const playableInListEl = document.getElementById('f-playable-in-list')!;
    const lastUpdatedEl = document.getElementById('last-updated')!;
    const filtersSidebarEl = document.getElementById('filters-sidebar')!;
    const filtersToggleBtn = document.getElementById('filters-toggle-btn')!;
    const sidebarBackdropEl = document.getElementById('sidebar-backdrop')!;

    // body.sidebar-open locks page scroll behind the mobile overlay.
    function setSidebarOpen(open: boolean) {
      filtersSidebarEl.classList.toggle('open', open);
      sidebarBackdropEl.classList.toggle('open', open);
      document.body.classList.toggle('sidebar-open', open);
    }
    filtersToggleBtn.addEventListener('click', () => setSidebarOpen(!filtersSidebarEl.classList.contains('open')));
    sidebarBackdropEl.addEventListener('click', () => setSidebarOpen(false));
    document.getElementById('sidebar-close-btn')!.addEventListener('click', () => setSidebarOpen(false));

    // Clears every sidebar filter (not the main search box).
    document.getElementById('reset-filters-btn')!.addEventListener('click', () => {
      filtersSidebarEl.querySelectorAll<HTMLInputElement>('[data-group] input[type="checkbox"]').forEach((cb) => (cb.checked = false));
      render();
    });

    function formatTimestamp(iso: string | null): string {
      if (!iso) return '—';
      return new Date(iso).toLocaleString(undefined, {
        year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
      });
    }

    async function loadLastUpdated() {
      const [{ data: sync }, { data: score }] = await Promise.all([
        supabase.from('catalog_syncs').select('synced_at').order('synced_at', { ascending: false }).limit(1).maybeSingle(),
        supabase.from('scores').select('updated_at').order('updated_at', { ascending: false }).limit(1).maybeSingle(),
      ]);
      lastUpdatedEl.innerHTML = `DB last updated: ${formatTimestamp(sync?.synced_at ?? null)}<br>Scores last updated: ${formatTimestamp(score?.updated_at ?? null)}`;
    }

    // substream (number 0) sits chronologically between 1st and 2nd style, not before 1st.
    const versionSortKey = (n: number) => (n === 0 ? 1.5 : n);
    // Version lists put arcade first, then INFINITAS, then CS and ULTIMATE
    // MOBILE (the same priority the catalog import uses to pick a song's
    // Version), chronological within each.
    const PLATFORM_ORDER = ['arcade', 'infinitas', 'cs', 'mobile'];
    function versionListKey(v: { number: number; platform: string | null }): number {
      const rank = PLATFORM_ORDER.indexOf(v.platform ?? 'arcade');
      return (rank < 0 ? PLATFORM_ORDER.length : rank) * 1000 + versionSortKey(v.number);
    }

    async function load() {
      // Supabase caps a single select at 1000 rows - page through until exhausted.
      const pageSize = 1000;
      let data: any[] = [];
      for (let from = 0; ; from += pageSize) {
        const { data: page, error } = await supabase
          .from('charts')
          .select(`
            id, song_id, play_style, difficulty, level, note_count, chart_label,
            songs ( title, title_english, artist, remywiki_url, bpm_min, bpm_max, versions ( number, name, platform ) ),
            scores ( ex_score, clear_lamp, miss_count, updated_at ),
            chart_availability ( versions ( number, name, platform ) )
          `)
          .range(from, from + pageSize - 1);

        if (error) {
          statusEl.textContent = `Failed to load: ${error.message}`;
          return;
        }
        data = data.concat(page ?? []);
        if (!page || page.length < pageSize) break;
      }

      rows = (data ?? []).map((c: any) => ({
        chartId: c.id,
        songId: c.song_id,
        version: c.songs?.versions?.name ?? 'Unknown',
        versionKey: c.songs?.versions ? versionListKey(c.songs.versions) : 1e9,
        title: c.songs?.title ?? '(unknown)',
        titleEnglish: c.songs?.title_english ?? '',
        artist: c.songs?.artist ?? '',
        wikiUrl: c.songs?.remywiki_url ?? null,
        style: c.play_style,
        difficulty: c.difficulty,
        level: c.level,
        noteCount: c.note_count,
        bpmMin: c.songs?.bpm_min ?? null,
        bpmMax: c.songs?.bpm_max ?? null,
        chartLabel: c.chart_label ?? null,
        playableIn: (c.chart_availability ?? []).map((a: any) => a.versions?.name).filter(Boolean),
        exScore: c.scores?.ex_score ?? null,
        lamp: c.scores?.clear_lamp ?? null,
        missCount: c.scores?.miss_count ?? null,
        scoreUpdatedAt: c.scores?.updated_at ?? null,
        searchText: searchKey(`${c.songs?.title ?? ''} ${c.songs?.title_english ?? ''}`),
      }));

      // Charts with a score sort by most-recently-updated first, surfacing
      // your latest plays. Charts with no score yet fall back to the fixed
      // catalog order (chronological version, then title/style/difficulty/
      // level) and always sort after every scored chart; that same fixed
      // order also breaks ties among scored charts.
      rows.sort((a, b) => {
        const aScored = a.scoreUpdatedAt != null;
        const bScored = b.scoreUpdatedAt != null;
        if (aScored !== bScored) return aScored ? -1 : 1;
        if (aScored && bScored && a.scoreUpdatedAt !== b.scoreUpdatedAt) {
          return a.scoreUpdatedAt! > b.scoreUpdatedAt! ? -1 : 1;
        }
        if (a.versionKey !== b.versionKey) return a.versionKey - b.versionKey;
        if (a.title !== b.title) return a.title.localeCompare(b.title);
        if (a.style !== b.style) return a.style.localeCompare(b.style);
        const ad = DIFF_ORDER.indexOf(a.difficulty);
        const bd = DIFF_ORDER.indexOf(b.difficulty);
        if (ad !== bd) return ad - bd;
        return a.level - b.level;
      });

      // Version lists every version a song debuted in; Playable In lists every
      // version any chart is playable in (which includes versions no song
      // debuted in, like ULTIMATE MOBILE), so each is built from its own data.
      const debutKeys = new Map<string, number>();
      const playableKeys = new Map<string, number>();
      for (const c of data) {
        const v = c.songs?.versions;
        debutKeys.set(v?.name ?? 'Unknown', v ? versionListKey(v) : 1e9);
        for (const a of c.chart_availability ?? []) {
          if (a.versions?.name) playableKeys.set(a.versions.name, versionListKey(a.versions));
        }
      }
      fillVersionList(versionListEl, debutKeys);
      fillVersionList(playableInListEl, playableKeys);
      versionListEl.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
        cb.addEventListener('input', render);
      });
      playableInListEl.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
        cb.addEventListener('input', render);
      });
      // chart_availability hasn't been populated yet; an always-empty filter just looks broken.
      if (!rows.some((r) => r.playableIn.length)) {
        playableInListEl.closest<HTMLElement>('.filter-group')!.hidden = true;
      }

      statusEl.style.display = 'none';
      loaded = true;
      // Filters from the URL, now that every checkbox (incl. versions) exists.
      applyParams(new URLSearchParams(location.search));
      pinTitleColumnWidth();
      render();
    }

    function fillVersionList(listEl: HTMLElement, keys: Map<string, number>) {
      for (const v of [...keys.keys()].sort((a, b) => keys.get(a)! - keys.get(b)!)) {
        const label = document.createElement('label');
        label.className = 'checkbox-row';
        label.innerHTML = `<input type="checkbox" value="${escapeHtml(v)}" /> ${escapeHtml(v)}`;
        listEl.appendChild(label);
      }
    }

    // With table-layout: fixed, the title column has no explicit width so it
    // fills whatever space the other (fixed-width) columns leave. Browsers
    // are supposed to derive that from the first row only, but toggling a
    // colspan expand-row can make them recompute it against the expand-row's
    // content instead, shrinking the title column. Pinning an explicit pixel
    // width (recomputed on resize) sidesteps that recalculation entirely.
    // These sums must match the col-chart/col-ex/col-grade/col-lamp/col-bp
    // widths in Layout.astro (desktop and the <=768px breakpoint).
    const OTHER_COLS_WIDTH_DESKTOP = 90 + 90 + 70 + 140 + 60;
    const OTHER_COLS_WIDTH_MOBILE = 64 + 60;
    const mobileMedia = window.matchMedia('(max-width: 768px)');
    const colTitleEl = tableEl.querySelector('col.col-title') as HTMLTableColElement;
    const tableScrollEl = tableEl.parentElement as HTMLElement;
    function pinTitleColumnWidth() {
      const otherWidth = mobileMedia.matches ? OTHER_COLS_WIDTH_MOBILE : OTHER_COLS_WIDTH_DESKTOP;
      // Measure the scroll container, not the table itself: the table's own
      // rendered width depends on the column widths we're about to set, so
      // measuring it here would create a self-referential feedback loop.
      const availableWidth = tableScrollEl.clientWidth;
      colTitleEl.style.width = `${Math.max(0, availableWidth - otherWidth)}px`;
    }
    new ResizeObserver(pinTitleColumnWidth).observe(tableScrollEl);
    mobileMedia.addEventListener('change', pinTitleColumnWidth);

    function checkedValues(groupName: string): Set<string> {
      const group = document.querySelector(`[data-group="${groupName}"]`)!;
      const checked = group.querySelectorAll('input[type="checkbox"]:checked');
      return new Set([...checked].map((el) => (el as HTMLInputElement).value));
    }

    function currentFilters() {
      return {
        search: searchKey(searchEl.value.trim()),
        versions: checkedValues('version'),
        playableIn: checkedValues('playable-in'),
        styles: checkedValues('style'),
        difficulties: checkedValues('difficulty'),
        grades: checkedValues('grade'),
        lamps: checkedValues('lamp'),
        levels: checkedValues('level'),
      };
    }

    // Filters and view mirror the URL (?view=stats&style=SP&diff=A&level=12
    // &lamp=HARD_CLEAR&grade=AA&version=...&playable=...&q=...; multi-select
    // groups repeat their key), so a filtered view can be linked, reloaded or
    // gone back to.
    const PARAM_GROUPS = {
      style: 'style', diff: 'difficulty', level: 'level', grade: 'grade', lamp: 'lamp', version: 'version', playable: 'playable-in',
    } as const;
    const searchEl = document.getElementById('f-search') as HTMLInputElement;

    function filterParams(): URLSearchParams {
      const p = new URLSearchParams();
      if (viewMode !== 'list') p.set('view', viewMode);
      if (viewMode === 'tier') {
        if (tierState.lamp) p.set('tlamp', tierState.lamp);
        if (tierState.table) p.set('table', tierState.table);
      }
      if (searchEl.value.trim()) p.set('q', searchEl.value.trim());
      for (const [key, group] of Object.entries(PARAM_GROUPS)) for (const v of checkedValues(group)) p.append(key, v);
      return p;
    }

    function applyParams(p: URLSearchParams) {
      searchEl.value = p.get('q') ?? '';
      for (const [key, group] of Object.entries(PARAM_GROUPS)) {
        const values = new Set(p.getAll(key));
        document.querySelectorAll<HTMLInputElement>(`[data-group="${group}"] input[type="checkbox"]`).forEach((cb) => (cb.checked = values.has(cb.value)));
        // Open the groups a link filters on, so the active filter is visible.
        if (values.size) document.querySelector(`.filter-group[data-group="${group}"]`)?.classList.add('open');
      }
      tierState = { lamp: (p.get('tlamp') ?? undefined) as TargetLamp | undefined, table: p.get('table') ?? undefined };
      const view = p.get('view');
      setView(view === 'song' || view === 'stats' || view === 'tier' ? view : 'list');
    }

    function syncUrl() {
      const qs = filterParams().toString();
      if (qs !== location.search.slice(1)) history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }

    // A count in the stats tables links to the list view with the current
    // filters narrowed to that cell: its row (grade or lamp) and/or level.
    function countLink(n: number, group: 'grade' | 'lamp', rowKey: string | null, level: number | null, bold = false): string {
      if (!n) return '';
      const p = filterParams();
      p.delete('view');
      if (rowKey != null) { p.delete(group); p.append(group, rowKey); }
      if (level != null) { p.delete('level'); p.append('level', String(level)); }
      const text = bold ? `<strong>${n}</strong>` : String(n);
      return `<a class="iidx-count" href="?${escapeHtml(p.toString())}">${text}</a>`;
    }

    // Pivot of matching charts: rows = grade or lamp, columns = level.
    function pivot(title: string, group: 'grade' | 'lamp', rowKeys: string[], rowLabel: (k: string) => string, keyOf: (r: Row) => string | null, charts: Row[]): string {
      const levels = [...new Set(charts.map((r) => r.level).filter((l) => l != null))].sort((a, b) => a - b);
      const counts = new Map(rowKeys.map((k) => [k, new Map<number, number>()]));
      for (const r of charts) {
        const m = counts.get(keyOf(r) ?? '');
        if (m) m.set(r.level, (m.get(r.level) ?? 0) + 1);
      }
      const body = rowKeys.map((k) => {
        const m = counts.get(k)!;
        const total = [...m.values()].reduce((a, b) => a + b, 0);
        if (!total) return '';
        return `<tr><th>${rowLabel(k)}</th>${levels.map((l) => `<td>${countLink(m.get(l) ?? 0, group, k, l)}</td>`).join('')}<td>${countLink(total, group, k, null, true)}</td></tr>`;
      }).join('');
      const colTotals = levels.map((l) => rowKeys.reduce((a, k) => a + (counts.get(k)!.get(l) ?? 0), 0));
      // Fixed column widths (table-layout: fixed), so the table's width is set to their sum.
      const [labelW, cellW, totalW] = [10, 2.75, 3.75];
      const width = labelW + levels.length * cellW + totalW;
      return `<h2 style="font-size:1rem; margin: 1.5rem 0 0.5rem;">${title}</h2>
        <div class="stats-scroll"><table class="pivot-table" style="width:${width}rem">
        <colgroup><col style="width:${labelW}rem" />${levels.map(() => `<col style="width:${cellW}rem" />`).join('')}<col style="width:${totalW}rem" /></colgroup>
        <thead><tr><th>Lv</th>${levels.map((l) => `<th>${l}</th>`).join('')}<th>Total</th></tr></thead>
        <tbody>${body}<tr><th>Total</th>${colTotals.map((t, i) => `<td>${countLink(t, group, null, levels[i], true)}</td>`).join('')}<td>${countLink(colTotals.reduce((a, b) => a + b, 0), group, null, null, true)}</td></tr></tbody></table></div>`;
    }

    function lampRowLabel(l: string): string {
      if (l === 'NONE') return LAMP_ROW_LABELS[l];
      const lamp = l as ClearLamp;
      return `<span class="iidx-lamp-dot" style="--lamp:${LAMP_FILLS[lamp] ?? LAMP_COLORS[lamp]}"></span>${LAMP_LABELS[lamp]}`;
    }

    function renderStats(filtered: Row[]) {
      statsContainerEl.innerHTML =
        pivot('Grade × Level', 'grade', [...GRADE_ORDER, '—'], (g) => (g === '—' ? 'No grade' : gradeHtml(g)), (r) => computeGrade(r.exScore, r.noteCount), filtered) +
        pivot('Lamp × Level', 'lamp', LAMP_ORDER, lampRowLabel, (r) => r.lamp ?? 'NONE', filtered);
    }

    function render() {
      if (!loaded) return;
      if (viewMode === 'tier') {
        renderTier();
        return;
      }
      syncUrl();
      const f = currentFilters();
      const filtered = rows.filter((r) => {
        if (f.search && !r.searchText.includes(f.search)) return false;
        if (f.versions.size && !f.versions.has(r.version)) return false;
        if (f.playableIn.size && !r.playableIn.some((v) => f.playableIn.has(v))) return false;
        if (f.styles.size && !f.styles.has(r.style)) return false;
        if (f.difficulties.size && !f.difficulties.has(r.difficulty)) return false;
        if (f.levels.size && !f.levels.has(String(r.level))) return false;
        if (f.lamps.size) {
          const lampValue = r.lamp ?? 'NONE';
          if (!f.lamps.has(lampValue)) return false;
        }
        if (f.grades.size && !f.grades.has(computeGrade(r.exScore, r.noteCount))) return false;
        return true;
      });

      if (viewMode === 'stats') {
        renderStats(filtered);
        return;
      }
      if (viewMode === 'song') {
        renderSongs(filtered);
        return;
      }

      listRows = filtered;
      renderedCount = Math.min(ROW_BATCH, listRows.length);
      tbody.innerHTML = listRows.slice(0, renderedCount).map(rowHtml).join('');
      fillViewport();
    }

    async function renderTier() {
      if (!tierView) {
        tierContainerEl.innerHTML = '<p class="tier-empty">Loading tier lists…</p>';
        const data = (await import('../tiers.json')).default as TierData;
        tierView ??= new TierView(
          data,
          rows,
          { main: tierContainerEl, lamps: document.getElementById('tier-lamps')!, tables: document.getElementById('tier-tables')!, tiers: document.getElementById('tier-tiers')! },
          (state) => {
            tierState = state;
            render();
            window.scrollTo(0, 0);
          },
          () => setSidebarOpen(false),
        );
      }
      if (viewMode !== 'tier') return;
      tierState = tierView.resolve(tierState);
      syncUrl();
      tierView.render(tierState as TierViewState, searchKey(searchEl.value.trim()));
    }

    // Rendering all ~12k rows at once makes a 12k-row DOM that's slow on
    // phones, so the list renders in batches as the sentinel below the table
    // scrolls into view.
    // Song records keep the list's order: a song sits where its first chart would.
    function renderSongs(filtered: Row[]) {
      songInFilter = new Set(filtered.map((r) => r.chartId));
      const keys = new Set(filtered.map((r) => `${r.songId}|${r.style}`));
      // Records hold every chart of the song, so filtered-out charts show dimmed.
      songRecs = songRecords(rows).filter((rec) => keys.has(rec.key));
      const order = new Map<string, number>();
      filtered.forEach((r, i) => { const k = `${r.songId}|${r.style}`; if (!order.has(k)) order.set(k, i); });
      songRecs.sort((a, b) => order.get(a.key)! - order.get(b.key)!);
      songRenderedCount = Math.min(SONG_BATCH, songRecs.length);
      songContainerEl.innerHTML =
        `<div class="sv-header" aria-hidden="true"><span>Song</span>${(['B', 'N', 'H', 'A', 'L'] as const).map((d) => `<span style="color:${DIFF_COLORS[d]}">${DIFF_NAMES[d]}</span>`).join('')}</div>` +
        `<div class="sv-list">${songRecs.slice(0, songRenderedCount).map((rec) => songRecordHtml(rec, songInFilter, showPctEl.checked)).join('')}</div>` +
        `<p class="sv-count">${songRecs.length} songs</p>`;
      fillViewport();
    }

    function appendMoreRows() {
      if (viewMode === 'song') {
        if (songRenderedCount >= songRecs.length) return;
        const next = Math.min(songRenderedCount + SONG_BATCH, songRecs.length);
        songContainerEl.querySelector('.sv-list')!.insertAdjacentHTML('beforeend', songRecs.slice(songRenderedCount, next).map((rec) => songRecordHtml(rec, songInFilter, showPctEl.checked)).join(''));
        songRenderedCount = next;
        fillViewport();
        return;
      }
      if (viewMode !== 'list' || renderedCount >= listRows.length) return;
      const next = Math.min(renderedCount + ROW_BATCH, listRows.length);
      tbody.insertAdjacentHTML('beforeend', listRows.slice(renderedCount, next).map((r, j) => rowHtml(r, renderedCount + j)).join(''));
      renderedCount = next;
      fillViewport();
    }
    // The observer only fires when the sentinel enters/leaves view, so keep
    // appending while it's still within range (tall screens, short batches).
    const tableSentinelEl = document.getElementById('table-sentinel')!;
    function fillViewport() {
      requestAnimationFrame(() => {
        if (tableSentinelEl.getBoundingClientRect().top < window.innerHeight + 1200) appendMoreRows();
      });
    }
    new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) appendMoreRows();
    }, { rootMargin: '1200px 0px' }).observe(tableSentinelEl);

    function rowHtml(r: Row, i: number): string {
      const grade = computeGrade(r.exScore, r.noteCount);
      const lampLabel = r.lamp ? LAMP_LABELS[r.lamp as keyof typeof LAMP_LABELS] : '—';
      const chartCode = `${r.style}${r.difficulty} ${r.level}`;
      const bpm = r.bpmMin == null
        ? '—'
        : r.bpmMax != null && r.bpmMax !== r.bpmMin
          ? `${r.bpmMin}–${r.bpmMax}`
          : `${r.bpmMin}`;
      const diffLabel = DIFF_LABELS[r.difficulty] ?? r.difficulty;
      const diffWithChartLabel = r.chartLabel ? `${diffLabel} (${escapeHtml(r.chartLabel)})` : diffLabel;
      return `<tr class="song-row" data-expand="expand-${i}">
        <td class="title-cell"><span class="iidx-lamp" data-lamp="${r.lamp ?? 'NO_PLAY'}" title="${r.lamp ? lampLabel : 'No Play'}"></span>${escapeHtml(r.title)}
          <div class="row-subtitle">${escapeHtml(r.artist)}</div>${
        r.titleEnglish && r.titleEnglish !== r.title
          ? `<div class="row-subtitle">${escapeHtml(r.titleEnglish)}</div>`
          : ''
      }</td>
        <td class="chart-code">${chartCode}</td>
        <td class="hide-mobile">${exHtml(r.exScore, r.noteCount)}</td>
        <td>${gradeHtml(grade)}</td>
        <td class="hide-mobile">${lampLabel}</td>
        <td class="hide-mobile">${r.missCount ?? '—'}</td>
      </tr>
      <tr class="expand-row" id="expand-${i}" style="display:none;">
        <td colspan="6">
          <span><strong>Version:</strong> ${escapeHtml(r.version)}</span>
          <span><strong>Style:</strong> ${STYLE_LABELS[r.style] ?? r.style}</span>
          <span><strong>Difficulty:</strong> ${diffWithChartLabel}</span>
          <span><strong>Level:</strong> ${r.level}</span>
          <span><strong>BPM:</strong> ${bpm}</span>
          <span><strong>Notes:</strong> ${r.noteCount ?? '—'}</span>
          <span class="show-mobile"><strong>EX Score:</strong> ${r.exScore ?? '—'}${showPctEl.checked && exPercent(r.exScore, r.noteCount) ? ` (${exPercent(r.exScore, r.noteCount)})` : ''}</span>
          <span class="show-mobile"><strong>BP:</strong> ${r.missCount ?? '—'}</span>
          <span class="show-mobile"><strong>Lamp:</strong> ${lampLabel}</span>${
        wikiUrl(r.wikiUrl)
          ? `<a class="wiki-link" href="${escapeHtml(wikiUrl(r.wikiUrl)!)}" target="_blank" rel="noopener noreferrer" title="Open on RemyWiki" aria-label="Open ${escapeHtml(r.title)} on RemyWiki"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>Wiki</a>`
          : ''
      }
          <div class="history" data-chart-id="${r.chartId}"></div>
        </td>
      </tr>`;
    }

    // Only http(s) links from the catalog become clickable.
    function wikiUrl(url: string | null): string | null {
      const u = url?.trim();
      return u && /^https?:\/\//i.test(u) ? u : null;
    }

    function escapeHtml(s: string) {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    }

    tbody.addEventListener('click', (e) => {
      const row = (e.target as HTMLElement).closest('tr.song-row') as HTMLElement | null;
      if (!row) return;
      const expandRow = document.getElementById(row.dataset.expand!) as HTMLElement | null;
      if (!expandRow) return;
      const isOpen = expandRow.style.display !== 'none';
      expandRow.style.display = isOpen ? 'none' : '';
      row.classList.toggle('open', !isOpen);
      if (!isOpen) showHistory(expandRow.querySelector<HTMLElement>('.history')!);
    });

    // Filled the first time a row is expanded (and again after a re-render).
    async function showHistory(el: HTMLElement, title = 'History') {
      if (el.dataset.loaded) return;
      el.dataset.loaded = '1';
      el.innerHTML = `<div class="history-title">${escapeHtml(title)}</div><p class="history-empty">Loading…</p>`;
      try {
        const attempts = await loadAttempts(supabase, 'iidx', Number(el.dataset.chartId), 'ex_score, clear_lamp, miss_count');
        el.querySelector('.history-empty')!.outerHTML = historyHtml(attempts.map((a) => ({
          at: a.submitted_at,
          score: a.ex_score,
          extraHtml: `<span class="history-extra">${[
            a.clear_lamp ? LAMP_LABELS[a.clear_lamp as keyof typeof LAMP_LABELS] : null,
            a.miss_count != null ? `BP ${a.miss_count}` : null,
          ].filter(Boolean).join(' · ')}</span>`,
        })), String);
      } catch (err: any) {
        el.querySelector('.history-empty')!.outerHTML = `<p class="history-error">Couldn't load history: ${escapeHtml(err.message ?? String(err))}</p>`;
      }
    }

    function setView(mode: ViewMode) {
      viewMode = mode;
      document.querySelectorAll<HTMLElement>('.view-btn').forEach((b) => b.classList.toggle('active', b.dataset.view === mode));
      tableEl.style.display = viewMode === 'list' && loaded ? '' : 'none';
      songContainerEl.style.display = viewMode === 'song' ? '' : 'none';
      // The batch-loading sentinel follows whichever list is showing.
      if (viewMode === 'song') songContainerEl.after(tableSentinelEl);
      else tableScrollEl.appendChild(tableSentinelEl);
      statsContainerEl.style.display = viewMode === 'stats' ? '' : 'none';
      tierContainerEl.style.display = viewMode === 'tier' ? '' : 'none';
      // The Tier view picks charts by table, so the filters give way to its own sidebar.
      tierSidebarEl.hidden = viewMode !== 'tier';
      filtersSectionEl.hidden = viewMode === 'tier';
    }
    document.querySelectorAll('.view-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        setView((btn as HTMLElement).dataset.view as ViewMode);
        render();
      });
    });

    // Clicking a count opens the filtered list in place (a new history entry,
    // so Back returns to the stats); modified clicks open it in a new tab.
    statsContainerEl.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.iidx-count');
      if (!link || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      history.pushState(null, '', link.href);
      applyParams(new URLSearchParams(link.search));
      render();
      window.scrollTo(0, 0);
    });
    window.addEventListener('popstate', () => {
      applyParams(new URLSearchParams(location.search));
      render();
    });

    searchEl.addEventListener('input', render);
    document.querySelectorAll('.style-toggle input[type="checkbox"]').forEach((cb) => cb.addEventListener('input', render));

    // Song view: the title opens song info, a difficulty opens its history.
    // One panel per record; opening the open one again closes it.
    function toggleSongPanel(trigger: HTMLElement) {
      const song = trigger.closest<HTMLElement>('.sv-song')!;
      const rec = songRecs.find((r) => r.key === song.dataset.key);
      if (!rec) return;
      const id = trigger.dataset.chartId ?? 'info';
      const open = song.querySelector<HTMLElement>('.sv-panel');
      song.querySelectorAll('[aria-expanded="true"]').forEach((el) => el.setAttribute('aria-expanded', 'false'));
      open?.remove();
      if (open?.dataset.for === id) return;
      trigger.setAttribute('aria-expanded', 'true');
      if (id === 'info') {
        song.insertAdjacentHTML('beforeend', songInfoHtml(rec));
        song.querySelector<HTMLElement>('.sv-panel')!.dataset.for = 'info';
        return;
      }
      const chart = rec.charts.find((c) => String(c.chartId) === id)!;
      const panel = document.createElement('div');
      panel.className = 'sv-panel history';
      panel.dataset.for = id;
      panel.dataset.chartId = id;
      panel.style.setProperty('--diff', DIFF_COLORS[chart.difficulty]);
      song.appendChild(panel);
      showHistory(panel, `${chart.chartLabel ?? DIFF_NAMES[chart.difficulty]} ${chart.level} history`);
    }
    songContainerEl.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>('.sv-head, .sv-chart[data-chart-id]');
      if (trigger && !(e.target as HTMLElement).closest('a')) toggleSongPanel(trigger);
    });
    songContainerEl.addEventListener('keydown', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>('.sv-head, .sv-chart[data-chart-id]');
      if (trigger && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        toggleSongPanel(trigger);
      }
    });

    document.querySelectorAll('.filter-group').forEach((group) => {
      const header = group.querySelector('.filter-group-header')!;
      header.addEventListener('click', () => group.classList.toggle('open'));
      group.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
        cb.addEventListener('input', render);
      });
    });

    load();
    loadLastUpdated();
  </script>
</Layout>
