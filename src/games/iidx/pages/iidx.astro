---
import Layout from '@/layouts/Layout.astro';
---
<Layout title="IIDX Score Tracker">
  <div class="page-header">
    <h1>beatmania IIDX Score Tracker</h1>
    <div id="last-updated" class="last-updated"></div>
  </div>

  <div class="layout">
    <aside class="filters-sidebar" id="filters-sidebar">
      <button type="button" id="sidebar-close-btn" class="sidebar-close-btn" aria-label="Close filters">✕</button>
      <div class="filters-heading">View</div>
      <div class="view-toggle">
        <button type="button" class="view-btn active" data-view="list">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          List
        </button>
        <button type="button" class="view-btn" data-view="stats">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          Statistics
        </button>
      </div>

      <div class="filters-heading">Filters</div>
      <button type="button" id="reset-filters-btn" class="reset-filters-btn">Reset filters</button>

      <div class="filter-group" data-group="style">
        <button type="button" class="filter-group-header">Play Style<span class="arrow">▸</span></button>
        <div class="filter-group-content">
          <label class="checkbox-row"><input type="checkbox" value="SP" /> Single Play</label>
          <label class="checkbox-row"><input type="checkbox" value="DP" /> Double Play</label>
        </div>
      </div>

      <div class="filter-group" data-group="difficulty">
        <button type="button" class="filter-group-header">Difficulty<span class="arrow">▸</span></button>
        <div class="filter-group-content">
          <label class="checkbox-row"><input type="checkbox" value="B" /> Beginner</label>
          <label class="checkbox-row"><input type="checkbox" value="N" /> Normal</label>
          <label class="checkbox-row"><input type="checkbox" value="H" /> Hyper</label>
          <label class="checkbox-row"><input type="checkbox" value="A" /> Another</label>
          <label class="checkbox-row"><input type="checkbox" value="L" /> Leggendaria</label>
        </div>
      </div>

      <div class="filter-group" data-group="grade">
        <button type="button" class="filter-group-header">Grade<span class="arrow">▸</span></button>
        <div class="filter-group-content">
          <label class="checkbox-row"><input type="checkbox" value="MAX" /> MAX</label>
          <label class="checkbox-row"><input type="checkbox" value="MAX-" /> MAX-</label>
          <label class="checkbox-row"><input type="checkbox" value="AAA" /> AAA</label>
          <label class="checkbox-row"><input type="checkbox" value="AA" /> AA</label>
          <label class="checkbox-row"><input type="checkbox" value="A" /> A</label>
          <label class="checkbox-row"><input type="checkbox" value="B" /> B</label>
          <label class="checkbox-row"><input type="checkbox" value="C" /> C</label>
          <label class="checkbox-row"><input type="checkbox" value="D" /> D</label>
          <label class="checkbox-row"><input type="checkbox" value="E" /> E</label>
          <label class="checkbox-row"><input type="checkbox" value="F" /> F</label>
          <label class="checkbox-row"><input type="checkbox" value="—" /> No grade</label>
        </div>
      </div>

      <div class="filter-group" data-group="lamp">
        <button type="button" class="filter-group-header">Clear Lamp<span class="arrow">▸</span></button>
        <div class="filter-group-content">
          <label class="checkbox-row"><input type="checkbox" value="FULL_COMBO" /> Full Combo</label>
          <label class="checkbox-row"><input type="checkbox" value="EX_HARD_CLEAR" /> EX Hard Clear</label>
          <label class="checkbox-row"><input type="checkbox" value="HARD_CLEAR" /> Hard Clear</label>
          <label class="checkbox-row"><input type="checkbox" value="CLEAR" /> Clear</label>
          <label class="checkbox-row"><input type="checkbox" value="EASY_CLEAR" /> Easy Clear</label>
          <label class="checkbox-row"><input type="checkbox" value="ASSIST_CLEAR" /> Assist Clear</label>
          <label class="checkbox-row"><input type="checkbox" value="FAILED" /> Failed</label>
          <label class="checkbox-row"><input type="checkbox" value="NONE" /> No score yet</label>
        </div>
      </div>

      <div class="filter-group" data-group="level">
        <button type="button" class="filter-group-header">Level<span class="arrow">▸</span></button>
        <div class="filter-group-content">
          {Array.from({ length: 12 }, (_, i) => i + 1).map((lv) => (
            <label class="checkbox-row"><input type="checkbox" value={lv} /> Lv. {lv}</label>
          ))}
        </div>
      </div>

      <div class="filter-group" data-group="version">
        <button type="button" class="filter-group-header">Version<span class="arrow">▸</span></button>
        <div class="filter-group-content" id="f-version-list"></div>
      </div>

      <div class="filter-group" data-group="playable-in">
        <button type="button" class="filter-group-header">Playable In<span class="arrow">▸</span></button>
        <div class="filter-group-content" id="f-playable-in-list"></div>
      </div>
    </aside>

    <div class="table-container">
      <div class="table-toolbar">
        <button type="button" id="filters-toggle-btn" class="filters-toggle-btn" aria-label="Toggle filters">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="18" x2="20" y2="18"></line></svg>
          Filters
        </button>
        <label class="search-row">Search
          <input id="f-search" type="text" placeholder="Song title..." />
        </label>
      </div>

      <p id="status" style="color: var(--text-dim);">Loading...</p>

      <div class="table-scroll">
        <table id="chart-table" style="display:none;">
          <colgroup>
            <col class="col-title" />
            <col class="col-chart" />
            <col class="col-ex hide-mobile" />
            <col class="col-grade" />
            <col class="col-lamp" />
            <col class="col-bp hide-mobile" />
          </colgroup>
          <thead>
            <tr>
              <th>Title</th>
              <th>Chart</th>
              <th class="hide-mobile">EX Score</th>
              <th>Grade</th>
              <th>Lamp</th>
              <th class="hide-mobile">BP</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
        <div id="table-sentinel"></div>
      </div>

      <div id="stats-container" style="display:none;"></div>
    </div>
  </div>

  <div id="sidebar-backdrop" class="sidebar-backdrop"></div>

  <!-- Global: the stats tables are built from JS, which scoped styles can't reach. -->
  <style is:global>
    /* Stats tables: every level column is the same fixed width (set by the
       <colgroup> from JS), so a 3-digit count doesn't stretch its column. */
    #stats-container .pivot-table { table-layout: fixed; }
    #stats-container .pivot-table td,
    #stats-container .pivot-table thead th:not(:first-child) { text-align: center; padding-left: 0; padding-right: 0; }
    .iidx-count { color: inherit; text-decoration: none; display: block; border-radius: 4px; }
    .iidx-count:focus-visible { outline: 2px solid var(--accent); }
    @media (hover: hover) { .iidx-count:hover { background: var(--border); text-decoration: underline; } }
    .iidx-lamp-dot {
      display: inline-block;
      width: 0.7rem;
      height: 0.7rem;
      margin-right: 0.3rem;
      border-radius: 50%;
      vertical-align: -0.05rem;
      background: var(--lamp);
    }

    /* Song-select clear lamp: a bar down the left edge of each record, with
       the in-game colours and flashing. */
    #chart-table .title-cell { position: relative; padding-left: calc(0.6rem + 9px); }
    .iidx-lamp {
      position: absolute;
      left: 3px;
      top: 3px;
      bottom: 3px;
      width: 6px;
      border-radius: 2px;
      background: #3a3a40;
    }
    .iidx-lamp[data-lamp="FAILED"] { animation: iidx-lamp-failed 0.5s infinite; }
    .iidx-lamp[data-lamp="ASSIST_CLEAR"] { background: #b26bff; box-shadow: 0 0 5px #b26bff99; }
    .iidx-lamp[data-lamp="EASY_CLEAR"] { background: #7cff4a; box-shadow: 0 0 5px #7cff4a99; }
    .iidx-lamp[data-lamp="CLEAR"] { background: #2b8fff; box-shadow: 0 0 5px #2b8fff99; }
    .iidx-lamp[data-lamp="HARD_CLEAR"] { background: #ffffff; box-shadow: 0 0 5px #ffffffaa; }
    .iidx-lamp[data-lamp="EX_HARD_CLEAR"] { animation: iidx-lamp-exhard 0.3s infinite; }
    .iidx-lamp[data-lamp="FULL_COMBO"] {
      background: linear-gradient(180deg, #ff3b3b, #ffb13b, #fff23b, #4dff6a, #3be8ff, #4a6bff, #c64dff, #ff3b3b);
      box-shadow: 0 0 5px #ffffff88;
      animation: iidx-lamp-rainbow 1s linear infinite;
    }
    /* Failed blinks red on and off. */
    @keyframes iidx-lamp-failed {
      0%, 49% { background: #ff2b2b; box-shadow: 0 0 6px #ff2b2bcc; }
      50%, 100% { background: #4a1014; box-shadow: none; }
    }
    /* EX Hard Clear cycles red, orange and yellow. */
    @keyframes iidx-lamp-exhard {
      0%, 32% { background: #ff2b2b; box-shadow: 0 0 6px #ff2b2bcc; }
      33%, 65% { background: #ff8a1c; box-shadow: 0 0 6px #ff8a1ccc; }
      66%, 100% { background: #ffe23b; box-shadow: 0 0 6px #ffe23bcc; }
    }
    /* Full Combo cycles through the rainbow. */
    @keyframes iidx-lamp-rainbow {
      from { filter: hue-rotate(0deg); }
      to { filter: hue-rotate(360deg); }
    }
    @media (prefers-reduced-motion: reduce) {
      .iidx-lamp { animation: none !important; }
      .iidx-lamp[data-lamp="FAILED"] { background: #ff2b2b; }
      .iidx-lamp[data-lamp="EX_HARD_CLEAR"] { background: linear-gradient(180deg, #ff2b2b, #ff8a1c, #ffe23b); }
    }
  </style>

  <script>
    import { requireSupabase } from '@/lib/supabase';
    import { computeGrade, LAMP_LABELS, LAMP_COLORS, LAMP_FILLS, type ClearLamp } from '../grade';
    import { searchKey } from '@/lib/search';
    import { loadAttempts, historyHtml } from '@/lib/history';

    const supabase = requireSupabase('iidx');

    const DIFF_LABELS: Record<string, string> = {
      B: 'Beginner', N: 'Normal', H: 'Hyper', A: 'Another', L: 'Leggendaria',
    };
    const STYLE_LABELS: Record<string, string> = { SP: 'Single Play', DP: 'Double Play' };
    const DIFF_ORDER = ['B', 'N', 'H', 'A', 'L'];
    const GRADE_ORDER = ['MAX', 'MAX-', 'AAA', 'AA', 'A', 'B', 'C', 'D', 'E', 'F'];
    const LAMP_ORDER = ['FULL_COMBO', 'EX_HARD_CLEAR', 'HARD_CLEAR', 'CLEAR', 'EASY_CLEAR', 'ASSIST_CLEAR', 'FAILED', 'NONE'];
    const LAMP_ROW_LABELS: Record<string, string> = { ...LAMP_LABELS, NONE: 'No score yet' };

    let viewMode: 'list' | 'stats' = 'list';
    let loaded = false;
    const ROW_BATCH = 200;
    let listRows: Row[] = [];
    let renderedCount = 0;

    type Row = {
      chartId: number;
      version: string;
      versionKey: number;
      title: string;
      titleEnglish: string;
      artist: string;
      style: string;
      difficulty: string;
      level: number;
      noteCount: number | null;
      bpmMin: number | null;
      bpmMax: number | null;
      chartLabel: string | null;
      exScore: number | null;
      lamp: string | null;
      missCount: number | null;
      scoreUpdatedAt: string | null;
      playableIn: string[];
      searchText: string;
    };

    let rows: Row[] = [];

    const statusEl = document.getElementById('status')!;
    const tableEl = document.getElementById('chart-table')!;
    const tbody = tableEl.querySelector('tbody')!;
    const statsContainerEl = document.getElementById('stats-container')!;
    const versionListEl = document.getElementById('f-version-list')!;
    const playableInListEl = document.getElementById('f-playable-in-list')!;
    const lastUpdatedEl = document.getElementById('last-updated')!;
    const filtersSidebarEl = document.getElementById('filters-sidebar')!;
    const filtersToggleBtn = document.getElementById('filters-toggle-btn')!;
    const sidebarBackdropEl = document.getElementById('sidebar-backdrop')!;

    // body.sidebar-open locks page scroll behind the mobile overlay.
    function setSidebarOpen(open: boolean) {
      filtersSidebarEl.classList.toggle('open', open);
      sidebarBackdropEl.classList.toggle('open', open);
      document.body.classList.toggle('sidebar-open', open);
    }
    filtersToggleBtn.addEventListener('click', () => setSidebarOpen(!filtersSidebarEl.classList.contains('open')));
    sidebarBackdropEl.addEventListener('click', () => setSidebarOpen(false));
    document.getElementById('sidebar-close-btn')!.addEventListener('click', () => setSidebarOpen(false));

    // Clears every sidebar filter (not the main search box).
    document.getElementById('reset-filters-btn')!.addEventListener('click', () => {
      filtersSidebarEl.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((cb) => (cb.checked = false));
      render();
    });

    function formatTimestamp(iso: string | null): string {
      if (!iso) return '—';
      return new Date(iso).toLocaleString(undefined, {
        year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
      });
    }

    async function loadLastUpdated() {
      const [{ data: sync }, { data: score }] = await Promise.all([
        supabase.from('catalog_syncs').select('synced_at').order('synced_at', { ascending: false }).limit(1).maybeSingle(),
        supabase.from('scores').select('updated_at').order('updated_at', { ascending: false }).limit(1).maybeSingle(),
      ]);
      lastUpdatedEl.innerHTML = `DB last updated: ${formatTimestamp(sync?.synced_at ?? null)}<br>Scores last updated: ${formatTimestamp(score?.updated_at ?? null)}`;
    }

    // substream (number 0) sits chronologically between 1st and 2nd style, not before 1st.
    const versionSortKey = (n: number) => (n === 0 ? 1.5 : n);
    // Version lists put arcade first, then INFINITAS, then CS and ULTIMATE
    // MOBILE (the same priority the catalog import uses to pick a song's
    // Version), chronological within each.
    const PLATFORM_ORDER = ['arcade', 'infinitas', 'cs', 'mobile'];
    function versionListKey(v: { number: number; platform: string | null }): number {
      const rank = PLATFORM_ORDER.indexOf(v.platform ?? 'arcade');
      return (rank < 0 ? PLATFORM_ORDER.length : rank) * 1000 + versionSortKey(v.number);
    }

    async function load() {
      // Supabase caps a single select at 1000 rows - page through until exhausted.
      const pageSize = 1000;
      let data: any[] = [];
      for (let from = 0; ; from += pageSize) {
        const { data: page, error } = await supabase
          .from('charts')
          .select(`
            id, play_style, difficulty, level, note_count, chart_label,
            songs ( title, title_english, artist, bpm_min, bpm_max, versions ( number, name, platform ) ),
            scores ( ex_score, clear_lamp, miss_count, updated_at ),
            chart_availability ( versions ( number, name, platform ) )
          `)
          .range(from, from + pageSize - 1);

        if (error) {
          statusEl.textContent = `Failed to load: ${error.message}`;
          return;
        }
        data = data.concat(page ?? []);
        if (!page || page.length < pageSize) break;
      }

      rows = (data ?? []).map((c: any) => ({
        chartId: c.id,
        version: c.songs?.versions?.name ?? 'Unknown',
        versionKey: c.songs?.versions ? versionListKey(c.songs.versions) : 1e9,
        title: c.songs?.title ?? '(unknown)',
        titleEnglish: c.songs?.title_english ?? '',
        artist: c.songs?.artist ?? '',
        style: c.play_style,
        difficulty: c.difficulty,
        level: c.level,
        noteCount: c.note_count,
        bpmMin: c.songs?.bpm_min ?? null,
        bpmMax: c.songs?.bpm_max ?? null,
        chartLabel: c.chart_label ?? null,
        playableIn: (c.chart_availability ?? []).map((a: any) => a.versions?.name).filter(Boolean),
        exScore: c.scores?.ex_score ?? null,
        lamp: c.scores?.clear_lamp ?? null,
        missCount: c.scores?.miss_count ?? null,
        scoreUpdatedAt: c.scores?.updated_at ?? null,
        searchText: searchKey(`${c.songs?.title ?? ''} ${c.songs?.title_english ?? ''}`),
      }));

      // Charts with a score sort by most-recently-updated first, surfacing
      // your latest plays. Charts with no score yet fall back to the fixed
      // catalog order (chronological version, then title/style/difficulty/
      // level) and always sort after every scored chart; that same fixed
      // order also breaks ties among scored charts.
      rows.sort((a, b) => {
        const aScored = a.scoreUpdatedAt != null;
        const bScored = b.scoreUpdatedAt != null;
        if (aScored !== bScored) return aScored ? -1 : 1;
        if (aScored && bScored && a.scoreUpdatedAt !== b.scoreUpdatedAt) {
          return a.scoreUpdatedAt! > b.scoreUpdatedAt! ? -1 : 1;
        }
        if (a.versionKey !== b.versionKey) return a.versionKey - b.versionKey;
        if (a.title !== b.title) return a.title.localeCompare(b.title);
        if (a.style !== b.style) return a.style.localeCompare(b.style);
        const ad = DIFF_ORDER.indexOf(a.difficulty);
        const bd = DIFF_ORDER.indexOf(b.difficulty);
        if (ad !== bd) return ad - bd;
        return a.level - b.level;
      });

      // Version lists every version a song debuted in; Playable In lists every
      // version any chart is playable in (which includes versions no song
      // debuted in, like ULTIMATE MOBILE), so each is built from its own data.
      const debutKeys = new Map<string, number>();
      const playableKeys = new Map<string, number>();
      for (const c of data) {
        const v = c.songs?.versions;
        debutKeys.set(v?.name ?? 'Unknown', v ? versionListKey(v) : 1e9);
        for (const a of c.chart_availability ?? []) {
          if (a.versions?.name) playableKeys.set(a.versions.name, versionListKey(a.versions));
        }
      }
      fillVersionList(versionListEl, debutKeys);
      fillVersionList(playableInListEl, playableKeys);
      versionListEl.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
        cb.addEventListener('input', render);
      });
      playableInListEl.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
        cb.addEventListener('input', render);
      });
      // chart_availability hasn't been populated yet; an always-empty filter just looks broken.
      if (!rows.some((r) => r.playableIn.length)) {
        playableInListEl.closest<HTMLElement>('.filter-group')!.hidden = true;
      }

      statusEl.style.display = 'none';
      loaded = true;
      // Filters from the URL, now that every checkbox (incl. versions) exists.
      applyParams(new URLSearchParams(location.search));
      pinTitleColumnWidth();
      render();
    }

    function fillVersionList(listEl: HTMLElement, keys: Map<string, number>) {
      for (const v of [...keys.keys()].sort((a, b) => keys.get(a)! - keys.get(b)!)) {
        const label = document.createElement('label');
        label.className = 'checkbox-row';
        label.innerHTML = `<input type="checkbox" value="${escapeHtml(v)}" /> ${escapeHtml(v)}`;
        listEl.appendChild(label);
      }
    }

    // With table-layout: fixed, the title column has no explicit width so it
    // fills whatever space the other (fixed-width) columns leave. Browsers
    // are supposed to derive that from the first row only, but toggling a
    // colspan expand-row can make them recompute it against the expand-row's
    // content instead, shrinking the title column. Pinning an explicit pixel
    // width (recomputed on resize) sidesteps that recalculation entirely.
    // These sums must match the col-chart/col-ex/col-grade/col-lamp/col-bp
    // widths in Layout.astro (desktop and the <=768px breakpoint).
    const OTHER_COLS_WIDTH_DESKTOP = 90 + 90 + 70 + 140 + 60;
    const OTHER_COLS_WIDTH_MOBILE = 64 + 60 + 92;
    const mobileMedia = window.matchMedia('(max-width: 768px)');
    const colTitleEl = tableEl.querySelector('col.col-title') as HTMLTableColElement;
    const tableScrollEl = tableEl.parentElement as HTMLElement;
    function pinTitleColumnWidth() {
      const otherWidth = mobileMedia.matches ? OTHER_COLS_WIDTH_MOBILE : OTHER_COLS_WIDTH_DESKTOP;
      // Measure the scroll container, not the table itself: the table's own
      // rendered width depends on the column widths we're about to set, so
      // measuring it here would create a self-referential feedback loop.
      const availableWidth = tableScrollEl.clientWidth;
      colTitleEl.style.width = `${Math.max(0, availableWidth - otherWidth)}px`;
    }
    new ResizeObserver(pinTitleColumnWidth).observe(tableScrollEl);
    mobileMedia.addEventListener('change', pinTitleColumnWidth);

    function checkedValues(groupName: string): Set<string> {
      const group = document.querySelector(`.filter-group[data-group="${groupName}"]`)!;
      const checked = group.querySelectorAll('input[type="checkbox"]:checked');
      return new Set([...checked].map((el) => (el as HTMLInputElement).value));
    }

    function currentFilters() {
      return {
        search: searchKey(searchEl.value.trim()),
        versions: checkedValues('version'),
        playableIn: checkedValues('playable-in'),
        styles: checkedValues('style'),
        difficulties: checkedValues('difficulty'),
        grades: checkedValues('grade'),
        lamps: checkedValues('lamp'),
        levels: checkedValues('level'),
      };
    }

    // Filters and view mirror the URL (?view=stats&style=SP&diff=A&level=12
    // &lamp=HARD_CLEAR&grade=AA&version=...&playable=...&q=...; multi-select
    // groups repeat their key), so a filtered view can be linked, reloaded or
    // gone back to.
    const PARAM_GROUPS = {
      style: 'style', diff: 'difficulty', level: 'level', grade: 'grade', lamp: 'lamp', version: 'version', playable: 'playable-in',
    } as const;
    const searchEl = document.getElementById('f-search') as HTMLInputElement;

    function filterParams(): URLSearchParams {
      const p = new URLSearchParams();
      if (viewMode === 'stats') p.set('view', 'stats');
      if (searchEl.value.trim()) p.set('q', searchEl.value.trim());
      for (const [key, group] of Object.entries(PARAM_GROUPS)) for (const v of checkedValues(group)) p.append(key, v);
      return p;
    }

    function applyParams(p: URLSearchParams) {
      searchEl.value = p.get('q') ?? '';
      for (const [key, group] of Object.entries(PARAM_GROUPS)) {
        const values = new Set(p.getAll(key));
        document.querySelectorAll<HTMLInputElement>(`.filter-group[data-group="${group}"] input[type="checkbox"]`).forEach((cb) => (cb.checked = values.has(cb.value)));
        // Open the groups a link filters on, so the active filter is visible.
        if (values.size) document.querySelector(`.filter-group[data-group="${group}"]`)?.classList.add('open');
      }
      setView(p.get('view') === 'stats' ? 'stats' : 'list');
    }

    function syncUrl() {
      const qs = filterParams().toString();
      if (qs !== location.search.slice(1)) history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }

    // A count in the stats tables links to the list view with the current
    // filters narrowed to that cell: its row (grade or lamp) and/or level.
    function countLink(n: number, group: 'grade' | 'lamp', rowKey: string | null, level: number | null, bold = false): string {
      if (!n) return '';
      const p = filterParams();
      p.delete('view');
      if (rowKey != null) { p.delete(group); p.append(group, rowKey); }
      if (level != null) { p.delete('level'); p.append('level', String(level)); }
      const text = bold ? `<strong>${n}</strong>` : String(n);
      return `<a class="iidx-count" href="?${escapeHtml(p.toString())}">${text}</a>`;
    }

    // Pivot of matching charts: rows = grade or lamp, columns = level.
    function pivot(title: string, group: 'grade' | 'lamp', rowKeys: string[], rowLabel: (k: string) => string, keyOf: (r: Row) => string | null, charts: Row[]): string {
      const levels = [...new Set(charts.map((r) => r.level).filter((l) => l != null))].sort((a, b) => a - b);
      const counts = new Map(rowKeys.map((k) => [k, new Map<number, number>()]));
      for (const r of charts) {
        const m = counts.get(keyOf(r) ?? '');
        if (m) m.set(r.level, (m.get(r.level) ?? 0) + 1);
      }
      const body = rowKeys.map((k) => {
        const m = counts.get(k)!;
        const total = [...m.values()].reduce((a, b) => a + b, 0);
        if (!total) return '';
        return `<tr><th>${rowLabel(k)}</th>${levels.map((l) => `<td>${countLink(m.get(l) ?? 0, group, k, l)}</td>`).join('')}<td>${countLink(total, group, k, null, true)}</td></tr>`;
      }).join('');
      const colTotals = levels.map((l) => rowKeys.reduce((a, k) => a + (counts.get(k)!.get(l) ?? 0), 0));
      // Fixed column widths (table-layout: fixed), so the table's width is set to their sum.
      const [labelW, cellW, totalW] = [10, 2.75, 3.75];
      const width = labelW + levels.length * cellW + totalW;
      return `<h2 style="font-size:1rem; margin: 1.5rem 0 0.5rem;">${title}</h2>
        <div class="stats-scroll"><table class="pivot-table" style="width:${width}rem">
        <colgroup><col style="width:${labelW}rem" />${levels.map(() => `<col style="width:${cellW}rem" />`).join('')}<col style="width:${totalW}rem" /></colgroup>
        <thead><tr><th>Lv</th>${levels.map((l) => `<th>${l}</th>`).join('')}<th>Total</th></tr></thead>
        <tbody>${body}<tr><th>Total</th>${colTotals.map((t, i) => `<td>${countLink(t, group, null, levels[i], true)}</td>`).join('')}<td>${countLink(colTotals.reduce((a, b) => a + b, 0), group, null, null, true)}</td></tr></tbody></table></div>`;
    }

    function lampRowLabel(l: string): string {
      if (l === 'NONE') return LAMP_ROW_LABELS[l];
      const lamp = l as ClearLamp;
      return `<span class="iidx-lamp-dot" style="--lamp:${LAMP_FILLS[lamp] ?? LAMP_COLORS[lamp]}"></span>${LAMP_LABELS[lamp]}`;
    }

    function renderStats(filtered: Row[]) {
      statsContainerEl.innerHTML =
        pivot('Grade × Level', 'grade', [...GRADE_ORDER, '—'], (g) => (g === '—' ? 'No grade' : g), (r) => computeGrade(r.exScore, r.noteCount), filtered) +
        pivot('Lamp × Level', 'lamp', LAMP_ORDER, lampRowLabel, (r) => r.lamp ?? 'NONE', filtered);
    }

    function render() {
      if (!loaded) return;
      syncUrl();
      const f = currentFilters();
      const filtered = rows.filter((r) => {
        if (f.search && !r.searchText.includes(f.search)) return false;
        if (f.versions.size && !f.versions.has(r.version)) return false;
        if (f.playableIn.size && !r.playableIn.some((v) => f.playableIn.has(v))) return false;
        if (f.styles.size && !f.styles.has(r.style)) return false;
        if (f.difficulties.size && !f.difficulties.has(r.difficulty)) return false;
        if (f.levels.size && !f.levels.has(String(r.level))) return false;
        if (f.lamps.size) {
          const lampValue = r.lamp ?? 'NONE';
          if (!f.lamps.has(lampValue)) return false;
        }
        if (f.grades.size && !f.grades.has(computeGrade(r.exScore, r.noteCount))) return false;
        return true;
      });

      if (viewMode === 'stats') {
        renderStats(filtered);
        return;
      }

      listRows = filtered;
      renderedCount = Math.min(ROW_BATCH, listRows.length);
      tbody.innerHTML = listRows.slice(0, renderedCount).map(rowHtml).join('');
      fillViewport();
    }

    // Rendering all ~12k rows at once makes a 12k-row DOM that's slow on
    // phones, so the list renders in batches as the sentinel below the table
    // scrolls into view.
    function appendMoreRows() {
      if (viewMode !== 'list' || renderedCount >= listRows.length) return;
      const next = Math.min(renderedCount + ROW_BATCH, listRows.length);
      tbody.insertAdjacentHTML('beforeend', listRows.slice(renderedCount, next).map((r, j) => rowHtml(r, renderedCount + j)).join(''));
      renderedCount = next;
      fillViewport();
    }
    // The observer only fires when the sentinel enters/leaves view, so keep
    // appending while it's still within range (tall screens, short batches).
    const tableSentinelEl = document.getElementById('table-sentinel')!;
    function fillViewport() {
      requestAnimationFrame(() => {
        if (tableSentinelEl.getBoundingClientRect().top < window.innerHeight + 1200) appendMoreRows();
      });
    }
    new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) appendMoreRows();
    }, { rootMargin: '1200px 0px' }).observe(tableSentinelEl);

    function rowHtml(r: Row, i: number): string {
      const grade = computeGrade(r.exScore, r.noteCount);
      const lampLabel = r.lamp ? LAMP_LABELS[r.lamp as keyof typeof LAMP_LABELS] : '—';
      const chartCode = `${r.style}${r.difficulty} ${r.level}`;
      const bpm = r.bpmMin == null
        ? '—'
        : r.bpmMax != null && r.bpmMax !== r.bpmMin
          ? `${r.bpmMin}–${r.bpmMax}`
          : `${r.bpmMin}`;
      const diffLabel = DIFF_LABELS[r.difficulty] ?? r.difficulty;
      const diffWithChartLabel = r.chartLabel ? `${diffLabel} (${escapeHtml(r.chartLabel)})` : diffLabel;
      return `<tr class="song-row" data-expand="expand-${i}">
        <td class="title-cell"><span class="iidx-lamp" data-lamp="${r.lamp ?? 'NO_PLAY'}" title="${r.lamp ? lampLabel : 'No Play'}"></span>${escapeHtml(r.title)}
          <div class="row-subtitle">${escapeHtml(r.artist)}</div>${
        r.titleEnglish && r.titleEnglish !== r.title
          ? `<div class="row-subtitle">${escapeHtml(r.titleEnglish)}</div>`
          : ''
      }</td>
        <td class="chart-code">${chartCode}</td>
        <td class="hide-mobile">${r.exScore ?? '—'}</td>
        <td>${grade}</td>
        <td>${lampLabel}</td>
        <td class="hide-mobile">${r.missCount ?? '—'}</td>
      </tr>
      <tr class="expand-row" id="expand-${i}" style="display:none;">
        <td colspan="6">
          <span><strong>Version:</strong> ${escapeHtml(r.version)}</span>
          <span><strong>Style:</strong> ${STYLE_LABELS[r.style] ?? r.style}</span>
          <span><strong>Difficulty:</strong> ${diffWithChartLabel}</span>
          <span><strong>Level:</strong> ${r.level}</span>
          <span><strong>BPM:</strong> ${bpm}</span>
          <span><strong>Notes:</strong> ${r.noteCount ?? '—'}</span>
          <span class="show-mobile"><strong>EX Score:</strong> ${r.exScore ?? '—'}</span>
          <span class="show-mobile"><strong>BP:</strong> ${r.missCount ?? '—'}</span>
          <div class="history" data-chart-id="${r.chartId}"></div>
        </td>
      </tr>`;
    }

    function escapeHtml(s: string) {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    }

    tbody.addEventListener('click', (e) => {
      const row = (e.target as HTMLElement).closest('tr.song-row') as HTMLElement | null;
      if (!row) return;
      const expandRow = document.getElementById(row.dataset.expand!) as HTMLElement | null;
      if (!expandRow) return;
      const isOpen = expandRow.style.display !== 'none';
      expandRow.style.display = isOpen ? 'none' : '';
      row.classList.toggle('open', !isOpen);
      if (!isOpen) showHistory(expandRow.querySelector<HTMLElement>('.history')!);
    });

    // Filled the first time a row is expanded (and again after a re-render).
    async function showHistory(el: HTMLElement) {
      if (el.dataset.loaded) return;
      el.dataset.loaded = '1';
      el.innerHTML = '<div class="history-title">History</div><p class="history-empty">Loading…</p>';
      try {
        const attempts = await loadAttempts(supabase, 'iidx', Number(el.dataset.chartId), 'ex_score, clear_lamp, miss_count');
        el.querySelector('.history-empty')!.outerHTML = historyHtml(attempts.map((a) => ({
          at: a.submitted_at,
          score: a.ex_score,
          extraHtml: `<span class="history-extra">${[
            a.clear_lamp ? LAMP_LABELS[a.clear_lamp as keyof typeof LAMP_LABELS] : null,
            a.miss_count != null ? `BP ${a.miss_count}` : null,
          ].filter(Boolean).join(' · ')}</span>`,
        })), String);
      } catch (err: any) {
        el.querySelector('.history-empty')!.outerHTML = `<p class="history-error">Couldn't load history: ${escapeHtml(err.message ?? String(err))}</p>`;
      }
    }

    function setView(mode: 'list' | 'stats') {
      viewMode = mode;
      document.querySelectorAll<HTMLElement>('.view-btn').forEach((b) => b.classList.toggle('active', b.dataset.view === mode));
      tableEl.style.display = viewMode === 'list' && loaded ? '' : 'none';
      statsContainerEl.style.display = viewMode === 'stats' ? '' : 'none';
    }
    document.querySelectorAll('.view-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        setView((btn as HTMLElement).dataset.view as 'list' | 'stats');
        render();
      });
    });

    // Clicking a count opens the filtered list in place (a new history entry,
    // so Back returns to the stats); modified clicks open it in a new tab.
    statsContainerEl.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.iidx-count');
      if (!link || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      history.pushState(null, '', link.href);
      applyParams(new URLSearchParams(link.search));
      render();
      window.scrollTo(0, 0);
    });
    window.addEventListener('popstate', () => {
      applyParams(new URLSearchParams(location.search));
      render();
    });

    searchEl.addEventListener('input', render);

    document.querySelectorAll('.filter-group').forEach((group) => {
      const header = group.querySelector('.filter-group-header')!;
      header.addEventListener('click', () => group.classList.toggle('open'));
      group.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
        cb.addEventListener('input', render);
      });
    });

    load();
    loadLastUpdated();
  </script>
</Layout>
