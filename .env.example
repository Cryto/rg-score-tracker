# Copy this file to .env and fill in your own Supabase project's values.
# Project Settings > API in the Supabase dashboard.
# Astro only exposes env vars prefixed with PUBLIC_ to client-side code.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only needed locally when running catalog import scripts (db/import/*).
# NEVER commit this, never expose it to the browser, never prefix it with PUBLIC_.
# Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
